# lumped_C_parallel_plate.rlab — 3-D Laplace on a finite parallel-plate
# capacitor: two square plates of side L separated by a gap d in air.
#
# Two ways to read C off the field — they should agree to discretisation
# precision:
#   Energy:   C = 2 U_E / V_0²,     U_E = ½ ε_0 ∫ |E|² dV
#   Gauss:    C = Q  / V_0,         Q  = ε_0 ∮ E·n̂ dA on a surface
#                                         enclosing the +V plate.
#
# Compared against the textbook C₀ = ε_0 L² / d plus Kirchhoff's
# fringing correction
#       C ≈ C₀ · [1 + (d/πL) · (1 + ln(2 π L / d))].
#
# Grid budget: laplacian_3d at n³ = 25³ ≈ 16k unknowns solves in ~5 s
# interpreted; that's the working size for one geometry. Sweeping L/d
# requires re-solving for each ratio, so we run a single representative
# L/d = 5 point and overlay it on the analytic curve.
#
# At this resolution (d = 2 cells, L = 10 cells, box margin ~ 6 cells)
# the energy method tracks the ideal C₀ to within a few percent — the
# Dirichlet box wall cuts the fringing field off too aggressively for
# the volume integral to see it. The Gauss method, integrating right
# at the plate face, catches the strong field near the conductor edges
# and overshoots Kirchhoff by ~10 %. The two bracket the analytic
# Kirchhoff value from below and above. Refining the grid (Exercise 1)
# tightens both onto Kirchhoff.
#
# Units: SI throughout. C in F (printed in pF for readability).
#
# Reference: ../../notebooks/15-lumped-capacitance.md.

eps0 = 8.854187817e-12;

# === Grid (n³ cubic, unit-cell side h) ===
# We work in integer (i, j, kk) cell space via ijk2k; no need for the
# 2-D meshgrid here. h is the cell side in metres; final C scales
# linearly with h (Coulomb-law geometric homogeneity).
n  = 25;
h  = 1.0e-3;                                  # 1 mm cells
N  = n * n * n;

# === Plate geometry: L_over_d = 5 (fits at n = 25 with margin) ===
# Higher L/d ratios need a finer grid — flagged as an exercise.
L_over_d = 5;
d_gap_cells = 2;                              # plate-to-plate spacing in cells
L_plate_cells = L_over_d * d_gap_cells;       # plate side length in cells

# Plate centres (cells); centre the gap at the box centre in z.
zc = round(n / 2);
z_lo = zc - round(d_gap_cells / 2);           # bottom-plate z-row
z_hi = z_lo + d_gap_cells;                    # top-plate z-row
# Plate footprint (square, x-y indices).
xy_lo = round((n - L_plate_cells) / 2) + 1;
xy_hi = xy_lo + L_plate_cells - 1;
print(z_lo)                                   # bottom-plate index
print(z_hi)                                   # top-plate index
print(xy_lo)
print(xy_hi)

# === Pin Dirichlet conditions ===
# Reuse L05's "row pin" idiom: zero out the row of the unknowns at the
# pinned cell, set diagonal to 1, RHS = pin value. Outer box wall stays
# at V = 0 by the laplacian_3d Dirichlet default (no row pin needed).
V0 = 1.0;
L_lap = laplacian_3d(n, n, n, h, h, h);
A = -1 * L_lap;                               # Poisson sign: ∇²V = 0 inside dielectric
b = zeros(1, N);

# Build the set of pinned cells (top plate at +V0/2, bottom at −V0/2).
function k = idx3(i, j, kk, n)
  k = ijk2k(i, j, kk, n, n);
end

# Pin a single cell to V_val: identity row at k, zero its 6 neighbours
# in the column-major (i, j, kk) layout used by laplacian_3d.
function [A_out, b_out] = pin_cell(A, b, ii, jj, kk, n, V_val)
  k = ijk2k(ii, jj, kk, n, n);
  A(k, k) = 1.0;
  if ii > 1;  A(k, ijk2k(ii-1, jj, kk, n, n)) = 0.0; end
  if ii < n;  A(k, ijk2k(ii+1, jj, kk, n, n)) = 0.0; end
  if jj > 1;  A(k, ijk2k(ii, jj-1, kk, n, n)) = 0.0; end
  if jj < n;  A(k, ijk2k(ii, jj+1, kk, n, n)) = 0.0; end
  if kk > 1;  A(k, ijk2k(ii, jj, kk-1, n, n)) = 0.0; end
  if kk < n;  A(k, ijk2k(ii, jj, kk+1, n, n)) = 0.0; end
  b(k) = V_val;
  A_out = A;
  b_out = b;
end

for jj = xy_lo:xy_hi
  for ii = xy_lo:xy_hi
    [A, b] = pin_cell(A, b, ii, jj, z_hi, n, +V0 / 2);
    [A, b] = pin_cell(A, b, ii, jj, z_lo, n, -V0 / 2);
  end
end

# === Solve ===
print(N)                                      # 15 625
V_flat = spsolve(A, b);
V = reshape(V_flat, n, n, n);                 # Tensor3 (i=y, j=x, k=z)

# Sanity: top-plate centre should sit at +0.5, bottom at −0.5.
ic = round((xy_lo + xy_hi) / 2);
jc = round((xy_lo + xy_hi) / 2);
print(real(V(ic, jc, z_hi)))                  # ≈ +0.5
print(real(V(ic, jc, z_lo)))                  # ≈ -0.5

# === Energy method ===
# E = −∇V; U_E = ½ ε_0 ∑ |E|² · h³. Only the dielectric (non-pinned)
# cells contribute — conductor cells have zero internal field. The
# gradient3 stencil happens to vanish on a uniform-V plate interior,
# so including those cells in the sum adds nothing.
[Ex, Ey, Ez] = gradient3(V, h, h, h);
Ex = -Ex; Ey = -Ey; Ez = -Ez;
# V is real (real Laplace), so E is real. (real(...) doesn't apply to
# Tensor3, but the result is already real — drop the wrapper.)
E_sq = Ex .* Ex + Ey .* Ey + Ez .* Ez;
# Tensor3(:) flatten currently panics; reshape to a vector instead.
E_sq_flat = reshape(E_sq, 1, N);
U_energy = 0.5 * eps0 * sum(E_sq_flat) * (h * h * h);
C_energy = 2 * U_energy / (V0 * V0);
print(C_energy * 1e15)                        # fF (for whatever h-unit we picked)

# === Gauss method ===
# Tight pillbox hugging the top-plate footprint. Bottom face one cell
# below the plate row (kk = z_hi − 1, in the gap), top face one cell
# above (kk = z_hi + 1), side faces flush with the plate edges. Field
# samples at the cell centres adjacent to the box; dA = h² per cell.
# By Gauss's theorem, ε₀ ∮ E·n̂ dA on any closed surface around the
# top plate equals the total free charge it carries → Q / V₀ = C.
kg_lo = z_hi - 1;   kg_hi = z_hi + 1;

# −z face (outward normal −ẑ; in the gap, Ez < 0, so −Ez > 0)
flux_mz = -sum(sum(Ez(xy_lo:xy_hi, xy_lo:xy_hi, kg_lo)));
# +z face (outward normal +ẑ; above the plate, weak Ez component)
flux_pz =  sum(sum(Ez(xy_lo:xy_hi, xy_lo:xy_hi, kg_hi)));
# +x / −x faces (outward normals ±x̂)
flux_px =  sum(sum(Ex(xy_lo:xy_hi, xy_hi, kg_lo:kg_hi)));
flux_mx = -sum(sum(Ex(xy_lo:xy_hi, xy_lo, kg_lo:kg_hi)));
# +y / −y faces (outward normals ±ŷ)
flux_py =  sum(sum(Ey(xy_hi, xy_lo:xy_hi, kg_lo:kg_hi)));
flux_my = -sum(sum(Ey(xy_lo, xy_lo:xy_hi, kg_lo:kg_hi)));

flux_total = flux_pz + flux_mz + flux_px + flux_mx + flux_py + flux_my;
Q_gauss = eps0 * flux_total * (h * h);        # per-face dA = h²
C_gauss = Q_gauss / V0;
print(C_gauss * 1e15)                         # fF

# === Analytic baselines ===
A_plate = (L_plate_cells * h) ^ 2;            # plate area
d_gap   = d_gap_cells * h;
L_side  = L_plate_cells * h;
C0      = eps0 * A_plate / d_gap;             # ideal parallel-plate
# Kirchhoff fringing correction
C_kirch = C0 * (1 + (d_gap / (pi * L_side)) * (1 + log(2 * pi * L_side / d_gap)));
print(C0 * 1e15)
print(C_kirch * 1e15)
print(C_energy / C0)                          # numerical / ideal — should be > 1 (fringing)
print(C_energy / C_kirch)                     # numerical / Kirchhoff — should be ≈ 1

# === Sweep the analytic Kirchhoff curve + overlay our single point ===
L_over_d_sweep = linspace(5, 50, 41);
C_ideal_sweep  = ones(1, length(L_over_d_sweep));   # C / C₀ = 1 by definition
C_kirch_sweep  = 1 + (1 ./ (pi * L_over_d_sweep)) .* (1 + log(2 * pi * L_over_d_sweep));

figure();
hold on;
plot(L_over_d_sweep, C_ideal_sweep, "C / C₀ = 1 (ideal)");
plot(L_over_d_sweep, C_kirch_sweep, "Kirchhoff (analytic)");
scatter(L_over_d, C_energy / C0,    "numerical (energy)");
scatter(L_over_d, C_gauss  / C0,    "numerical (Gauss)");
hold off;
xlabel("L / d");
ylabel("C / C_0");
title("Finite parallel-plate fringing — numerical vs. Kirchhoff");
legend("ideal", "Kirchhoff", "numerical (energy)", "numerical (Gauss)");
savefig("parallel_plate_fringing.svg");

# === Field snapshot (mid-y slice) ===
V_slice = zeros(n, n);
for kk = 1:n
  for jj = 1:n
    V_slice(jj, kk) = real(V(ic, jj, kk));
  end
end
figure();
imagesc(V_slice, "viridis");
title("V on the y = midplane slice — fringing visible at the plate edges");
xlabel("z cell"); ylabel("x cell");
savefig("parallel_plate_V_slice.svg");

print(1)
