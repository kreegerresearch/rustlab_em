# MIM_capacitor_3d.rlab — Thin-film metal-insulator-metal capacitor.
#
# Stack: two 10 µm × 10 µm rectangular metal plates separated by a
# 100 nm layer of high-K dielectric (ε_r = 25, typical Ta₂O₅ /
# HfO₂-class). Anisotropic grid: dx = dy = 1 µm (10 cells/plate side)
# but dz = 25 nm (4 cells through the 100 nm dielectric). The total
# 3-D box is 25 µm × 25 µm × ~ 625 nm in metres — the dielectric is
# the bulk of the cell volume, and the air margin above / below the
# plates absorbs near-field fringing without dominating the solve.
#
# Single 3-D Laplace solve at n³ = 25³ ≈ 16k unknowns, ε(x, y, z)
# baked into the operator. C is read via the same energy + Gauss
# pair as `lumped_C_parallel_plate.rlab`.
#
# Analytic check: C = ε_r ε₀ A / d
#                   = 25 × 8.854e−12 × 1e−10 / 1e−7
#                   ≈ 221 fF.
#
# Units: SI. C printed in fF.
#
# Reference: ../../notebooks/15-lumped-capacitance.md.

eps0 = 8.854187817e-12;
eps_r = 25.0;

# === Grid ===
n  = 25;
dx = 1.0e-6;                                  # 1 µm in x, y
dy = dx;
dz = 25e-9;                                   # 25 nm in z
N  = n * n * n;

# === Geometry ===
xy_lo = 8;  xy_hi = 17;                       # 10 × 10 plate footprint
z_lo  = 11; z_hi  = 15;                       # plates separated by 4 cells = 100 nm
d_gap = (z_hi - z_lo) * dz;
A_plate = ((xy_hi - xy_lo + 1) * dx)^2;
print(d_gap * 1e9)                            # 100  nm
print(A_plate * 1e12)                         # 100  µm²

# === 3-D ε map: ε_r = 25 between the plates, 1 (air) elsewhere ===
# laplacian_3d has no eps-variant yet, so the script enforces variable
# permittivity *outside* the stencil: scale Q-integral by the local ε
# during the Gauss step. The Laplace operator itself stays uniform,
# which is the right thing for a single-material region (the dielectric
# fills the entire plate-to-plate volume) provided the plates pin the
# field; the air above/below sees ε = 1 but contributes only fringing.
# A second solve at uniform ε_r captures the air-region-as-dielectric
# limit (Exercise 1).

L_lap = laplacian_3d(n, n, n, dx, dy, dz);
A = -1 * L_lap;
b = zeros(1, N);
V0 = 1.0;

function [A_out, b_out] = pin_cell(A, b, ii, jj, kk, n, V_val)
  k = ijk2k(ii, jj, kk, n, n);
  A(k, k) = 1.0;
  if ii > 1;  A(k, ijk2k(ii-1, jj, kk, n, n)) = 0.0; end
  if ii < n;  A(k, ijk2k(ii+1, jj, kk, n, n)) = 0.0; end
  if jj > 1;  A(k, ijk2k(ii, jj-1, kk, n, n)) = 0.0; end
  if jj < n;  A(k, ijk2k(ii, jj+1, kk, n, n)) = 0.0; end
  if kk > 1;  A(k, ijk2k(ii, jj, kk-1, n, n)) = 0.0; end
  if kk < n;  A(k, ijk2k(ii, jj, kk+1, n, n)) = 0.0; end
  b(k) = V_val;
  A_out = A;
  b_out = b;
end

for jj = xy_lo:xy_hi
  for ii = xy_lo:xy_hi
    [A, b] = pin_cell(A, b, ii, jj, z_hi, n, +V0 / 2);
    [A, b] = pin_cell(A, b, ii, jj, z_lo, n, -V0 / 2);
  end
end

# === Solve ===
V_flat = spsolve(A, b);
V = reshape(V_flat, n, n, n);

ic = round((xy_lo + xy_hi) / 2);
print(real(V(ic, ic, z_hi)))                  # +0.5
print(real(V(ic, ic, z_lo)))                  # −0.5

# === Energy method ===
# U_E = ½ ∫ ε|E|² dV. ε = ε_r ε_0 inside the gap (between plates), ε_0
# outside. Split the volume sum.
[Ex, Ey, Ez] = gradient3(V, dx, dy, dz);
Ex = -Ex; Ey = -Ey; Ez = -Ez;
E_sq = Ex .* Ex + Ey .* Ey + Ez .* Ez;
E_sq_flat = reshape(E_sq, 1, N);

# Build a flat ε mask: ε_r inside the gap, 1 outside. The gap is
# everywhere with kk strictly between z_lo and z_hi (z_lo + 1 .. z_hi − 1).
# Plate cells themselves contribute zero field energy (E=0 inside conductor).
eps_map = ones(1, N);
for kk = (z_lo + 1):(z_hi - 1)
  for jj = 1:n
    for ii = 1:n
      eps_map(ijk2k(ii, jj, kk, n, n)) = eps_r;
    end
  end
end

U_energy = 0.5 * eps0 * sum(eps_map .* E_sq_flat) * (dx * dy * dz);
C_energy = 2 * U_energy / (V0 * V0);
print(C_energy * 1e15)                        # fF

# === Gauss method (tight pillbox around top plate) ===
kg_lo = z_hi - 1;  kg_hi = z_hi + 1;

# Bottom face flux: in the dielectric, multiply by eps_r.
flux_mz = -sum(sum(Ez(xy_lo:xy_hi, xy_lo:xy_hi, kg_lo))) * eps_r;
# Top face flux: in air, multiply by 1.
flux_pz =  sum(sum(Ez(xy_lo:xy_hi, xy_lo:xy_hi, kg_hi)));
# Side faces: half-dielectric, half-air; approximate as average ε.
eps_side = (eps_r + 1.0) / 2;
flux_px =  sum(sum(Ex(xy_lo:xy_hi, xy_hi, kg_lo:kg_hi))) * eps_side;
flux_mx = -sum(sum(Ex(xy_lo:xy_hi, xy_lo, kg_lo:kg_hi))) * eps_side;
flux_py =  sum(sum(Ey(xy_hi, xy_lo:xy_hi, kg_lo:kg_hi))) * eps_side;
flux_my = -sum(sum(Ey(xy_lo, xy_lo:xy_hi, kg_lo:kg_hi))) * eps_side;

# Per-face dA. The xy-faces have area dx·dy per cell; the side faces
# have area dx·dz (or dy·dz).
Q_top_face = eps0 * (flux_mz + flux_pz) * (dx * dy);
Q_side     = eps0 * (flux_px + flux_mx + flux_py + flux_my) * (dx * dz);
Q_gauss    = Q_top_face + Q_side;
C_gauss    = Q_gauss / V0;
print(C_gauss * 1e15)                         # fF

# === Analytic ===
C_ideal = eps_r * eps0 * A_plate / d_gap;
print(C_ideal * 1e15)                         # ≈ 221 fF
print(C_energy / C_ideal)
print(C_gauss  / C_ideal)

# === Slice plot (xz mid-y) ===
V_slice = zeros(n, n);
for kk = 1:n
  for jj = 1:n
    V_slice(jj, kk) = real(V(ic, jj, kk));
  end
end
figure();
imagesc(V_slice, "viridis");
title(sprintf("MIM cap: V on xz mid-y slice (ε_r = %.0f)", eps_r));
xlabel("z cell"); ylabel("x cell");
savefig("MIM_capacitor_V_slice.svg");

print(1)
