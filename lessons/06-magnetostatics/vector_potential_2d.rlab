# vector_potential_2d.rlab — 2D Az-Poisson for two opposing parallel wires.
#
# Geometry:   two infinite wires along ẑ at x = ±d/2 with currents ±I.
#             0.30 × 0.30 m grounded outer box on a 150 × 150 grid.
# Method:     ∇²Az = -μ₀ Jz, solved as A V = b with A = -laplacian_2d
#             and b = μ₀ Jz(:).'. Recover B = (∂Az/∂y, -∂Az/∂x).
# Verifies:   By(0, y) at y ≈ 0.05 m sits ~14.5 % below the analytic
#             two-wire formula By = -μ₀ I d / (2π((d/2)² + y²)) evaluated
#             at the snapped wire separation d_act = 0.0417 m (single-cell
#             sources + grounded box; the residual shrinks under refinement).
#
# Reference: ../../notebooks/06-magnetostatics.md.

mu0 = 4 * pi * 1e-7;
nx = 150; ny = 150;
Lx = 0.30; Ly = 0.30;
dx = Lx / (nx + 1);
dy = Ly / (ny + 1);
xs = dx * (1:nx) - Lx/2;
ys = dy * (1:ny) - Ly/2;
[Xw, Yw] = meshgrid(xs, ys);

# === Currents: single-cell wires at ±d/2 ===
d_wires = 0.04;
I_wire  = 1.0;
J = zeros(ny, nx);
j_pos = round((d_wires/2 + Lx/2) / dx);
j_neg = round((-d_wires/2 + Lx/2) / dx);
i_mid = round(ny / 2);
J(i_mid, j_pos) =  I_wire / (dx * dy);
J(i_mid, j_neg) = -I_wire / (dx * dy);

# === Sparse Poisson solve ===
L = laplacian_2d(nx, ny, dx, dy);
A_mat = -1 * L;
b = mu0 * J(:).';              # .' = plain transpose (no conjugation)
Az = real(reshape(spsolve(A_mat, b), ny, nx));

# === Plots ===
figure();
hold on;
imagesc(Az, "viridis");
contour(Xw, Yw, Az, 14, "k");
title("Az(x, y) for two opposing parallel wires");
hold off;
savefig("two_wires_Az.svg");

[Az_x, Az_y] = gradient(Az, dx, dy);
Bx_w = Az_y;
By_w = -Az_x;

# Subsample every 5th cell — 30×30 arrows instead of the full 150×150
# grid's 22,500, which would render as unreadable noise.
figure();
quiver(Xw(1:5:end, 1:5:end), Yw(1:5:end, 1:5:end), ...
       Bx_w(1:5:end, 1:5:end), By_w(1:5:end, 1:5:end), "B field from curl A");
xlabel("x (m)");
ylabel("y (m)");
savefig("two_wires_B.svg");

# === Validation ===
# Compare against the analytic two-wire formula evaluated at the wires'
# actual grid positions — snapped separation d_act = 0.0417 m rather than
# the nominal 0.04 m: read the geometry off the grid.
j_mid  = nx / 2;
i_test = round((0.05 + Ly/2) / dy);
y_test = ys(i_test);
d_act  = xs(j_pos) - xs(j_neg);       # actual snapped wire separation
r2     = (d_act/2)^2 + y_test^2;
By_an  = -mu0 * I_wire * d_act / (2 * pi * r2);
print(real(By_w(i_test, j_mid)))      # numerical ≈ -2.38e-6 T
print(By_an)                          # analytic  ≈ -2.78e-6 T (snapped geometry)
