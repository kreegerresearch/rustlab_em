# iron_core_shielding.rlab — Wire inside an iron annulus; flux concentration.
#
# Geometry:   1-A wire at the centre of a 0.20 × 0.20 m grounded box,
#             surrounded by an iron annulus (μ_r = 1000) with inner radius
#             4 cm and outer radius 6 cm.
# Method:     ∇·((1/μ_r) ∇ Az) = -μ₀ Jz, solved with laplacian_eps_2d on
#             the reluctivity map 1/μ_r and a single-cell current source.
# Observe:    |B| in the iron is ~ μ_r × the surrounding-vacuum value,
#             concentrating flux through the iron. Exterior |B| tracks
#             the bare-wire μ₀ I/(2π r) — Ampère pins H regardless of μ_r
#             in this cylindrically symmetric geometry: ~6.6 % agreement
#             at the snapped r = 7.11 cm sample, but ~20 % high at the
#             snapped r = 9.09 cm sample, which sits only ~1 cm from the
#             grounded Az = 0 box wall that compresses the return flux.
#             (Radii are read off the grid — the wire cell itself snaps
#             ~0.8 mm off the nominal centre. See lesson notes and
#             Exercise 5 for true exterior shielding via an applied field.)
#
# Reference: ../../notebooks/06-magnetostatics.md.

mu0 = 4 * pi * 1e-7;
nx2 = 120; ny2 = 120;
Lx2 = 0.20; Ly2 = 0.20;
dxi = Lx2 / (nx2 + 1);
dyi = Ly2 / (ny2 + 1);
xsi = dxi * (1:nx2) - Lx2/2;
ysi = dyi * (1:ny2) - Ly2/2;
[Xi, Yi] = meshgrid(xsi, ysi);

# === Iron annulus mask (Lesson 04 idiom) ===
disk_outer = disk_mask(Xi, Yi, 0.0, 0.0, 0.06);
disk_inner = disk_mask(Xi, Yi, 0.0, 0.0, 0.04);
iron       = disk_outer .* (1 - disk_inner);

figure();
imagesc(iron, "viridis");
title("Iron annulus mask (mu_r = 1000 in the ring, 1 elsewhere)");
savefig("iron_mask.svg");

# === Permeability and reluctivity maps ===
# `iron` is a 0/1 mask: 1 inside the annulus, 0 outside. Lift it to
# μ_r ∈ {1, 1000} with a single elementwise expression.
mu_r   = 1.0 + 999.0 * iron;
inv_mu = 1.0 ./ mu_r;

# === Source: single-cell wire at the centre ===
J = zeros(ny2, nx2);
i_c = round(ny2 / 2);
j_c = round(nx2 / 2);
J(i_c, j_c) = 1.0 / (dxi * dyi);

# === Variable-permeability sparse solve ===
L_inv = laplacian_eps_2d(inv_mu, dxi, dyi);
A_inv = -1 * L_inv;
b_inv = mu0 * J(:).';          # .' = plain transpose (no conjugation)
Az_inv = real(reshape(spsolve(A_inv, b_inv), ny2, nx2));

figure();
hold on;
imagesc(Az_inv, "viridis");
contour(Xi, Yi, Az_inv, 16, "k");
title("Az(x, y) — wire inside an iron shell");
hold off;
savefig("iron_Az.svg");

# === Recover B and sample along +x axis ===
[Az_x_i, Az_y_i] = gradient(Az_inv, dxi, dyi);
Bx_i = Az_y_i;
By_i = -Az_x_i;
Bmag = sqrt(Bx_i .^ 2 + By_i .^ 2);

figure();
imagesc(real(Bmag), "viridis");
title("|B|(x, y): bright ring is the iron, exterior is bare-wire-like");
savefig("iron_Bmag.svg");

j_iron  = round((0.05 + Lx2/2) / dxi);
j_outer = round((0.07 + Lx2/2) / dxi);
j_far   = round((0.09 + Lx2/2) / dxi);
# Read the sample radii off the grid: the wire cell sits at xsi(j_c)
# ≈ -0.8 mm, so the outer samples land at r = 7.11 cm and 9.09 cm,
# not the nominal 7 and 9 cm.
r_out = xsi(j_outer) - xsi(j_c);    # snapped sample radius ≈ 0.0711 m
r_far = xsi(j_far)   - xsi(j_c);    # snapped sample radius ≈ 0.0909 m
print(real(Bmag(i_c, j_iron)))      # iron interior — large
print(real(Bmag(i_c, j_outer)))     # just outside — ~6.6% above bare-wire
print(real(Bmag(i_c, j_far)))       # further out — ~20% above bare-wire
                                    # (grounded box wall only ~1 cm away)
print(mu0 * 1.0 / (2 * pi * r_out)) # bare-wire reference at snapped r = 7.11 cm
print(mu0 * 1.0 / (2 * pi * r_far)) # bare-wire reference at snapped r = 9.09 cm
