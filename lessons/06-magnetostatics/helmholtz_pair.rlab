# helmholtz_pair.rlab — Coaxial coil pair, on-axis Bz uniformity sweep.
#
# Geometry:   two coaxial loops, radius R = 5 cm, current I = 1 A each,
#             separation d swept across {0.5R, 1.0R, 1.5R}.
# Theory:     d²Bz/dz² at midplane vanishes when d = R (Helmholtz condition).
#             The flat field at d/R = 1 is the calibration field for many
#             magnetometers and atomic-physics experiments.
#
# Closed form: Bz(z) = (μ₀IR²/2) [1/((R²+(z-d/2)²)^(3/2)) +
#                                  1/((R²+(z+d/2)²)^(3/2))]
#
# Reference: ../../notebooks/06-magnetostatics.md.

mu0 = 4 * pi * 1e-7;
Ih  = 1.0;
Rh  = 0.05;
zline  = linspace(-0.06, 0.06, 121);
ratios = [0.5, 1.0, 1.5];

figure();
hold on;
for rk = 1:3
  d_h = ratios(rk) * Rh;
  Bz_pair = (mu0 * Ih * Rh^2 / 2.0) * ...
            (1.0 ./ ((Rh^2 + (zline - d_h/2) .^ 2) .^ 1.5) + ...
             1.0 ./ ((Rh^2 + (zline + d_h/2) .^ 2) .^ 1.5));
  plot(zline * 100, real(Bz_pair));
end
hold off;
xlabel("z (cm)");
ylabel("Bz (T)");
title("Helmholtz pair: Bz(z) for d/R = 0.5, 1.0, 1.5");
legend("d/R = 0.5", "d/R = 1.0 (Helmholtz)", "d/R = 1.5");
savefig("helmholtz_sweep.svg");

# Quantify uniformity: Bz(z = 0) vs Bz(z = ±0.5R) for each ratio.
for rk = 1:3
  d_h = ratios(rk) * Rh;
  Bz0 = (mu0 * Ih * Rh^2) / ((Rh^2 + (d_h/2)^2) ^ 1.5);
  z_off = 0.5 * Rh;
  Bz_off = (mu0 * Ih * Rh^2 / 2.0) * ...
           (1.0 / ((Rh^2 + (z_off - d_h/2)^2) ^ 1.5) + ...
            1.0 / ((Rh^2 + (z_off + d_h/2)^2) ^ 1.5));
  print(real(Bz_off / Bz0))
end
# Ratio closest to 1 → Helmholtz d/R = 1
