# fdfd_1d_layers.rlab — 1-D scalar Helmholtz on a stratified dielectric.
#
# Demonstrates a quarter-wave anti-reflection (AR) coating: a single
# dielectric layer between vacuum and a substrate (ε_r = 4) of thickness
# t = λ₀/(4 n_AR) with n_AR = (n_air n_sub)^{1/2} = 2^{1/2} eliminates
# reflection at the design frequency.
#
# Equation: d²E_z/dx² + k₀² ε(x) E_z = -i ω μ₀ J_z(x).
# SC-PML on both ends absorbs outgoing waves; the field in the air
# region is then approximately E_inc(+x propagating) + E_refl(-x).
#
# Outputs:
#   (i)  |E_z(x)| at design frequency for AR-coated and uncoated cases
#        — the air-region standing-wave ripple disappears with AR.
#   (ii) frequency sweep of |E_z| in the substrate; AR peaks at f₀ and
#        falls off on both sides; uncoated case is near-flat.
#
# Reference: ../../notebooks/10-fdfd-frequency-domain.md.

run "../_shared/em.rlab"

mu0  = 4 * pi * 1e-7;
eps0 = 8.854187817e-12;
c0   = 1 / sqrt(mu0 * eps0);

# === Design parameters ===
f0       = 5e9;
lambda0  = c0 / f0;
eps_air  = 1.0;
eps_sub  = 4.0;
eps_AR   = sqrt(eps_air * eps_sub);     # ε_r = 2 (quarter-wave AR)
n_AR     = sqrt(eps_AR);
t_AR     = lambda0 / (4 * n_AR);

# === Grid ===
dx        = lambda0 / 40;
npml      = 20;
sigma_max = 4 * eps0 * c0 / dx;
n_air_L   = round(2 * lambda0 / dx);
n_air_R   = round(1 * lambda0 / dx);
n_AR_c    = round(t_AR / dx);
n_sub_c   = round(2 * lambda0 / dx);
N         = 2 * npml + n_air_L + 1 + n_air_R + n_AR_c + n_sub_c;

# Layout: [PML | air_L | source | air_R | AR | sub | PML]
idx_src       = npml + n_air_L + 1;
idx_AR_start  = idx_src + n_air_R + 1;
idx_AR_end    = idx_AR_start + n_AR_c - 1;
idx_sub_start = idx_AR_end + 1;
idx_sub_end   = idx_sub_start + n_sub_c - 1;
idx_meas      = idx_sub_end - round(0.5 * lambda0 / dx);
idx_air_ref   = idx_src + round(0.5 * lambda0 / dx);

# === ε(x) profiles ===
# IMPORTANT: extend the substrate ε all the way through the right PML.
# If the PML region is left as ε=1, the substrate→vacuum interface at
# the PML inner edge reflects ~ 33 % of the wave straight back through
# the AR coating, swamping the desired transmission peak.
# Use the single-arg form (Vector) so range slice-assign accepts a scalar RHS.
eps_with_AR = ones(N) * eps_air;
eps_no_AR   = ones(N) * eps_air;
eps_with_AR(idx_AR_start:idx_AR_end) = eps_AR;
eps_with_AR(idx_sub_start:N)         = eps_sub;
eps_no_AR(idx_AR_start:N)            = eps_sub;

# === Single-frequency solver ===
function E = solve_1d(eps_x, N, dx, npml, sigma_max, omega, idx_src)
  mu0  = 4 * pi * 1e-7;
  eps0 = 8.854187817e-12;
  c0   = 1 / sqrt(mu0 * eps0);
  k0sq = (omega / c0)^2;
  # Face-centred SC-PML: separate stretching at primal cells and dual
  # faces. Without this the discrete operator has a residual reflection
  # at the PML inner edge that swamps the desired signal.
  sx_e = pml_stretching_factor(pml_sigma_profile  (N, npml, sigma_max), omega, eps0);
  sx_h = pml_stretching_factor(pml_sigma_profile_h(N, npml, sigma_max), omega, eps0);

  Ii = zeros(1, 3 * N);
  Ji = zeros(1, 3 * N);
  Vv = zeros(1, 3 * N);
  cnt = 0;
  for ii = 1:N
    if ii > 1
      am = 1 / (sx_e(ii) * sx_h(ii - 1) * dx * dx);
    else
      am = 0;
    end
    if ii < N
      ap = 1 / (sx_e(ii) * sx_h(ii) * dx * dx);
    else
      ap = 0;
    end
    # At ii = 1 and ii = N the missing neighbour drops out of both the
    # off-diagonal AND the diagonal (a± = 0), so the outer wall is
    # effectively a zero-Neumann boundary, not the PEC a reader might
    # assume behind the PML — invisible at the PML's ~ -100 dB level.
    diag_val = -ap - am + k0sq * eps_x(ii);
    cnt = cnt + 1;
    Ii(cnt) = ii; Ji(cnt) = ii; Vv(cnt) = diag_val;
    if ii > 1
      cnt = cnt + 1;
      Ii(cnt) = ii; Ji(cnt) = ii - 1; Vv(cnt) = am;
    end
    if ii < N
      cnt = cnt + 1;
      Ii(cnt) = ii; Ji(cnt) = ii + 1; Vv(cnt) = ap;
    end
  end
  A = sparse(Ii(1:cnt), Ji(1:cnt), Vv(1:cnt), N, N);
  b = zeros(1, N);
  b(idx_src) = -j * omega * mu0 / dx;
  E = spsolve(A, b);
end

# === Field snapshot at design frequency ===
omega0 = 2 * pi * f0;
E_AR   = solve_1d(eps_with_AR, N, dx, npml, sigma_max, omega0, idx_src);
E_noAR = solve_1d(eps_no_AR,   N, dx, npml, sigma_max, omega0, idx_src);

xs = (1:N) * dx;

# Reflection-coefficient proxy: ratio of (|E|_max - |E|_min) to mean
# in the air region. For a pure travelling wave this is ~ 0; finite
# reflection produces visible standing-wave ripple.
i_lo = idx_src + 10;
i_hi = idx_AR_start - 1;
absE_AR_air   = abs(E_AR(i_lo:i_hi));
absE_noAR_air = abs(E_noAR(i_lo:i_hi));
ripple_AR   = (max(absE_AR_air)   - min(absE_AR_air))   / mean(absE_AR_air);
ripple_noAR = (max(absE_noAR_air) - min(absE_noAR_air)) / mean(absE_noAR_air);
print(ripple_AR)
print(ripple_noAR)

figure();
hold on;
plot(xs / lambda0, abs(E_AR),   "with AR");
plot(xs / lambda0, abs(E_noAR), "no AR");
hold off;
xlabel("x / lambda0");
ylabel("|E_z|  (arb)");
title("1-D Helmholtz: quarter-wave AR vs uncoated substrate at f_0");
legend("with AR", "no AR");
savefig("fdfd_1d_E_profile.svg");

figure();
plot(xs / lambda0, eps_with_AR, "epsilon_r(x)");
xlabel("x / lambda0");
ylabel("eps_r");
title("Stratification — air | AR layer | substrate");
savefig("fdfd_1d_eps.svg");

# === Frequency sweep ===
f_list = linspace(0.6 * f0, 1.4 * f0, 21);
Nf = length(f_list);
T_AR_sq   = zeros(1, Nf);
T_noAR_sq = zeros(1, Nf);

for kf = 1:Nf
  freq = f_list(kf);
  omega = 2 * pi * freq;
  E1 = solve_1d(eps_with_AR, N, dx, npml, sigma_max, omega, idx_src);
  E2 = solve_1d(eps_no_AR,   N, dx, npml, sigma_max, omega, idx_src);
  T_AR_sq(kf)   = abs(E1(idx_meas))^2 / abs(E1(idx_air_ref))^2;
  T_noAR_sq(kf) = abs(E2(idx_meas))^2 / abs(E2(idx_air_ref))^2;
end

figure();
hold on;
plot(f_list / f0, T_AR_sq,   "with AR");
plot(f_list / f0, T_noAR_sq, "no AR");
hold off;
xlabel("f / f_0");
ylabel("|E_sub|^2 / |E_air|^2");
title("Frequency sweep: AR transmission peaks at design frequency");
legend("with AR", "no AR");
savefig("fdfd_1d_sweep.svg");
