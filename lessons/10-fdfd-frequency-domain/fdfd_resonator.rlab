# fdfd_resonator.rlab — Closed rectangular cavity, sweep frequency to
# expose the analytic TM_{m n} resonant modes.
#
# Cavity:    a × b = 0.10 m × 0.075 m, PEC on all four walls, filled
#            with a slightly lossy dielectric (ε_r = 1 + j·tan_delta).
#            The bulk loss replaces the absorbing-port idiom of a
#            "real" FDFD setup with a simpler scalar in the operator
#            — modes turn into Lorentzian peaks of finite height.
# Method:    Helmholtz operator A(ω) = ∇² + ω² μ₀ ε(complex) on a
#            uniform grid with Dirichlet BCs from `laplacian_2d`,
#            assembled as L + ω² μ₀ ε₀ M, where M is the diagonal
#            mass matrix built from the (complex) ε map.
# Drive:     point source at one corner well off any modal node; read
#            out |E_z| at a different corner, also off any node, and
#            plot |E|² over a frequency sweep covering several modes.
# Theory:    f_{m n} = c/(2 √(ε_r)) · √((m/a)² + (n/b)²),  m, n ≥ 1,
#            with c = 1/√(μ₀ ε₀). The Dirichlet (PEC) walls force
#            sin(mπx/a)·sin(nπy/b) in BOTH directions, so any zero
#            index kills the mode — TM10/TM01/TM20 do not exist.
#            For a = 0.10 m, b = 0.075 m, ε_r ≈ 1 the in-band modes
#            of a 1–4 GHz sweep are
#               TM11  ≈ 2.498 GHz
#               TM21  ≈ 3.603 GHz
#            (next is TM12 ≈ 4.269 GHz, just above the band).
#
# Reference: ../../notebooks/10-fdfd-frequency-domain.md.

mu0  = 4 * pi * 1e-7;
eps0 = 8.854187817e-12;
c0   = 1 / sqrt(mu0 * eps0);

# === Cavity ===
a_cav  = 0.10;
b_cav  = 0.075;
tan_d  = 0.005;     # bulk loss tangent — Q ≈ 1/tan_delta ≈ 200
eps_re = 1.0;
# Loss is a POSITIVE imaginary part under the e^{-iωt} convention used
# throughout Lesson 10 (matches the PML's s = 1 + iσ/(ωε₀); e^{+jωt}
# engineering texts write the same medium as ε_r(1 − j·tanδ)).
eps_c  = eps_re + j * eps_re * tan_d;     # ε with small loss

# === Grid ===
nx = 81;
ny = 61;
dx = a_cav / (nx + 1);   # Dirichlet boundary lives at i = 0 and i = nx + 1
dy = b_cav / (ny + 1);

N = nx * ny;
L = laplacian_2d(nx, ny, dx, dy);

# Source at a "non-modal" cell, away from likely nodes.
i_src = round(0.3 * ny);
j_src = round(0.3 * nx);
k_src = ij2k(i_src, j_src, ny);

# Measurement at a different corner.
i_meas = round(0.7 * ny);
j_meas = round(0.6 * nx);
k_meas = ij2k(i_meas, j_meas, ny);

# === Frequency sweep (parallel) ===
# Each frequency is an independent sparse solve. parmap dispatches the
# trials across rayon worker threads; the lambda must be pure (no plot
# / savefig / state mutation) and must reconstruct L, b, etc. itself
# since rustlab functions don't capture the enclosing scope.
f_lo = 1.0e9;
f_hi = 4.0e9;
Nf   = 121;
fs   = linspace(f_lo, f_hi, Nf);

# Diagonal mass: M = ε_c * I  (uniform), so the omega-dependent
# operator is A(ω) = L + ω² μ₀ ε₀ ε_c · I = L + ω² μ₀ ε_c (after
# absorbing ε₀ via c² = 1/(μ₀ε₀)). Equivalently A = L + (ω/c₀)² ε_c.
function a = fdfd_trial(kf)
  mu0  = 4 * pi * 1e-7;
  eps0 = 8.854187817e-12;
  c0   = 1 / sqrt(mu0 * eps0);
  a_cav = 0.10; b_cav = 0.075;
  tan_d = 0.005; eps_re = 1.0;
  eps_c = eps_re + j * eps_re * tan_d;
  nx = 81; ny = 61;
  dx = a_cav / (nx + 1); dy = b_cav / (ny + 1);
  N = nx * ny;
  L = laplacian_2d(nx, ny, dx, dy);
  k_src  = ij2k(round(0.3 * ny), round(0.3 * nx), ny);
  k_meas = ij2k(round(0.7 * ny), round(0.6 * nx), ny);
  fs = linspace(1.0e9, 4.0e9, 121);
  omega = 2 * pi * fs(kf);
  A = L + ((omega / c0)^2 * eps_c) * speye(N);
  b = zeros(N); b(k_src) = -j * omega * mu0;
  E_flat = spsolve(A, b);
  a = abs(E_flat(k_meas));
end
amp = parmap(@fdfd_trial, 1:Nf);

# Analytic resonance frequencies. Why no peak at 1.5 GHz? c/(2a) is
# what a naive "TM10" would give — but sin(nπy/b) with n = 0 vanishes
# identically, so the mode does not exist; the lowest real mode is TM11.
f_no_mode = c0 / (2 * a_cav) / sqrt(eps_re);
f_11 = (c0 / (2 * sqrt(eps_re))) * sqrt((1 / a_cav)^2 + (1 / b_cav)^2);
f_21 = (c0 / (2 * sqrt(eps_re))) * sqrt((2 / a_cav)^2 + (1 / b_cav)^2);
f_12 = (c0 / (2 * sqrt(eps_re))) * sqrt((1 / a_cav)^2 + (2 / b_cav)^2);
print(f_no_mode / 1e9)   # 1.50 — NO peak here in the sweep (m,n ≥ 1)
print(f_11 / 1e9)        # 2.50 — lowest mode, TM11
print(f_21 / 1e9)        # 3.60 — TM21
print(f_12 / 1e9)        # 4.27 — TM12, just above the sweep band

figure();
plot(fs / 1e9, amp, "|E_z(meas)| vs f");
xlabel("frequency  (GHz)");
ylabel("|E_z| at sample point");
title("Closed-cavity FDFD response — resonant peaks at TM_{m n}");
savefig("fdfd_resonator_sweep.svg");

# === Field snapshot at the lowest resonance, TM_{11} ===
omega_r = 2 * pi * f_11;
A_r  = L + ((omega_r / c0)^2 * eps_c) * speye(N);
b_r  = zeros(1, N);
b_r(k_src) = -j * omega_r * mu0;
E_r  = spsolve(A_r, b_r);
E_grid = reshape(E_r, ny, nx);
print(max(abs(E_r)))     # ~ 0.71 — antinode at the cavity centre

figure();
imagesc(real(E_grid), "viridis");
title("Re(E_z) at TM_{11} resonance — one half-sine lobe in x and in y");
xlabel("x cell index");
ylabel("y cell index");
savefig("fdfd_resonator_TM11.svg");

# Snapshot at TM_{21} — two lobes along x, one along y
omega_r = 2 * pi * f_21;
A_r  = L + ((omega_r / c0)^2 * eps_c) * speye(N);
b_r  = zeros(1, N);
b_r(k_src) = -j * omega_r * mu0;
E_r  = spsolve(A_r, b_r);
E_grid = reshape(E_r, ny, nx);

figure();
imagesc(real(E_grid), "viridis");
title("Re(E_z) at TM_{21} resonance — two lobes along x, one along y");
xlabel("x cell index");
ylabel("y cell index");
savefig("fdfd_resonator_TM21.svg");
