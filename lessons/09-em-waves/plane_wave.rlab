# plane_wave.rlab — A propagating, y-polarised plane wave in vacuum.
#
# Setup:    E_y(x, t) = E0 cos(k x - ω t),
#           B_z(x, t) = (E0 / c) cos(k x - ω t),
#           ω = c k. Propagation along +x; E ⊥ B ⊥ k.
# Outputs:  (i)  three-snapshot static SVG showing the wave shifting +x
#                between t = 0, T/4, T/2;
#           (ii) a GIF animation of E_y(x, t) and c·B_z(x, t) overlaid
#                across one period, generated with frame()/saveanim().
#           Verifies the |E|/|B| = c amplitude ratio numerically.
#
# Reference: ../../notebooks/09-em-waves.md.

mu0    = 4 * pi * 1e-7;
eps0   = 8.854187817e-12;
c      = 1 / sqrt(mu0 * eps0);
f      = 1.0e9;
omega  = 2 * pi * f;
kw     = omega / c;
lambda = c / f;
T      = 1 / f;
E0     = 1.0;

# Three wavelengths gives the eye enough room to read the phase shift
# without making the line plot busy.
Nx = 401;
xs = linspace(0, 3 * lambda, Nx);

# === Verify |E|/|B| = c ===
B0   = E0 / c;
ratio = E0 / B0;
print(ratio)            # → c ≈ 2.998e8

# === Static three-snapshot figure ===
ts_snap = [0, T / 4, T / 2];
Ey_t0   = E0 * cos(kw * xs - omega * ts_snap(1));
Ey_t1   = E0 * cos(kw * xs - omega * ts_snap(2));
Ey_t2   = E0 * cos(kw * xs - omega * ts_snap(3));

figure();
hold on;
plot(xs / lambda, Ey_t0, "t = 0");
plot(xs / lambda, Ey_t1, "t = T/4");
plot(xs / lambda, Ey_t2, "t = T/2");
hold off;
xlabel("x / lambda");
ylabel("E_y / E0");
title("y-polarised plane wave: snapshots showing +x propagation");
legend("t = 0", "t = T/4", "t = T/2");
savefig("plane_wave_snapshots.svg");

# === Static "E_y vs c·B_z share phase" figure at t = 0 ===
Bz_t0_scaled = c * B0 * cos(kw * xs - omega * ts_snap(1));   # = E0 cos(...)

figure();
hold on;
plot(xs / lambda, Ey_t0,        "E_y / E0");
plot(xs / lambda, Bz_t0_scaled, "c B_z / E0");
hold off;
xlabel("x / lambda");
title("E_y and c B_z — equal amplitude, same phase, perpendicular axes");
legend("E_y / E0", "c B_z / E0");
savefig("plane_wave_E_vs_B.svg");

# === Animation: GIF over one period ===
N_frames = 60;
figure();
for kf = 1:N_frames
  t   = (kf - 1) / N_frames * T;
  Ey  = E0 * cos(kw * xs - omega * t);
  cBz = c * B0 * cos(kw * xs - omega * t);   # c·B_z, not B_z itself
  hold on;
  plot(xs / lambda, Ey,  "E_y / E0");
  plot(xs / lambda, cBz, "c B_z / E0");
  hold off;
  xlim([0.0, 3.0]);
  ylim([-1.2, 1.2]);
  xlabel("x / lambda");
  title(sprintf("Plane wave  —  t / T = %.2f", t / T));
  legend("E_y / E0", "c B_z / E0");
  frame();
end
saveanim("plane_wave.gif", 24);
