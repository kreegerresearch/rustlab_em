# half_wave_dipole.rlab — Far-field radiation pattern and radiation
# resistance of a half-wave dipole.
#
# A linear dipole of total length L = λ/2 carries a sinusoidal current
# distribution I(z) = I_0 cos(kz) for |z| ≤ L/2. The far-field
# pattern factor is the Fourier transform of the current along the
# antenna axis, weighted by sin θ:
#   F(θ) = sin θ · ∫_{-L/2}^{L/2} cos(kz) e^{j k z cos θ} dz
# which evaluates in closed form to
#   F(θ) ∝ cos(π/2 · cos θ) / sin θ
# slightly narrower than the Hertzian's sin θ pattern.
#
# Radiation resistance (input impedance's real part):
#   R_rad = (η₀ / 2π) ∫_0^π [cos²(π/2 · cos θ) / sin θ] dθ ≈ 73.13 Ω
# The numerical integration below matches the textbook value to
# ~ 0.01 Ω.
#
# Reference: ../../notebooks/12-waveguides-and-radiation.md.

mu0 = 4 * pi * 1e-7;
eps0 = 8.854187817e-12;
c0   = 1 / sqrt(mu0 * eps0);
eta0 = sqrt(mu0 / eps0);

f0 = 1.0e9;
omega = 2 * pi * f0;
k0    = omega / c0;
lambda = c0 / f0;
L = lambda / 2;

# === Polar pattern: numerical integration ===
N_th = 361;
ths  = linspace(0.001, pi - 0.001, N_th);   # avoid sin θ = 0 singularity at endpoints

# Closed-form pattern factor
F_anal = cos(pi / 2 * cos(ths)) ./ sin(ths);
P_anal = F_anal .^ 2;

# Numerical pattern via integration over z
N_z = 201;
zs  = linspace(-L / 2, L / 2, N_z);
# `linspace` builds a true vector (not a 1×N matrix); needed so the
# polar plot below accepts F_num as the radial argument.
F_num = linspace(0, 0, N_th);
for t = 1:N_th
  integrand_re = cos(k0 * zs) .* cos(k0 * zs * cos(ths(t)));    # real part of integrand
  integrand_im = cos(k0 * zs) .* sin(k0 * zs * cos(ths(t)));    # imag part
  Fz_re = trapz(zs, integrand_re);
  Fz_im = trapz(zs, integrand_im);
  Fz_mag = sqrt(Fz_re^2 + Fz_im^2);
  F_num(t) = sin(ths(t)) * Fz_mag;
end

# Normalise both to unit peak for shape comparison
F_anal_n = F_anal / max(F_anal);
F_num_n  = F_num  / max(F_num);

figure();
polar(ths, F_anal_n, "analytic");
title("Half-wave dipole pattern — analytic |F(theta)|");
savefig("halfwave_polar_analytic.svg");

figure();
polar(ths, F_num_n, "numerical");
title("Half-wave dipole pattern — numerical |F(theta)|");
savefig("halfwave_polar_numerical.svg");

# Compare numerical vs analytic
err_pattern = max(abs(F_anal_n - F_num_n));
print(err_pattern)               # ~ 1e-4 to 1e-3

# === Radiation resistance via numerical surface integral ===
# R_rad = (η₀ / 2π) ∫_0^π [cos²(π/2 cos θ) / sin θ] dθ
# Note the integrand is regular at θ = 0, π (L'Hopital).
ths_R = linspace(0.001, pi - 0.001, 2001);
integrand_R = (cos(pi / 2 * cos(ths_R))) .^ 2 ./ sin(ths_R);
R_rad_num = eta0 / (2 * pi) * trapz(ths_R, integrand_R);
print(R_rad_num)                  # ~ 73.13 Ω
print(73.13)                      # textbook value
print(abs(R_rad_num - 73.13))

# === Comparison plot: half-wave vs Hertzian on the same axes ===
F_hertz_n = sin(ths);             # already peaks at 1
figure();
hold on;
polar(ths, F_anal_n,    "half-wave (cos(pi/2 cos θ)/sin θ)");
polar(ths, F_hertz_n,   "Hertzian  (sin θ)");
hold off;
title("Half-wave vs Hertzian: half-wave is slightly narrower");
legend("half-wave", "Hertzian");
savefig("halfwave_vs_hertzian.svg");
