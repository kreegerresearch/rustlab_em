# fdtd_2d_scattering.rlab — TMz Yee FDTD in 2-D; plane wave scatters
# off a PEC cylinder; animated.
#
# Polarisation: TMz (E_z out of plane, H_x and H_y in plane).
#   E_z(i, j)   on integer cells i = 1..ny, j = 1..nx
#   H_x(i, j)   at (i + 0.5, j) — last row unused
#   H_y(i, j)   at (i,   j + 0.5) — last col unused
# Leapfrog:
#   H_x(i,j) -= (dt / mu0 / dy) [E_z(i+1,j) - E_z(i,j)]
#   H_y(i,j) += (dt / mu0 / dx) [E_z(i,j+1) - E_z(i,j)]
#   E_z(i,j) += (dt / eps0) [(H_y(i,j) - H_y(i,j-1))/dx
#                          - (H_x(i,j) - H_x(i-1,j))/dy]
# CFL: c0 dt ≤ Δ / √2 in 2-D.
#
# Source: a CW (continuous-wave) sinusoidal line source of E_z at
# column j_src, added only on rows 2:ny-1. Those are the rows the E
# update actually touches. Adding the source on rows 1 and ny (which
# the leapfrog never updates) integrates the drive there — |E_z| grows
# to ~10 — and the PEC top and bottom then support a parallel-plate
# mode rather than a plane wave (empty-domain lee/lit ratio ~1.36).
# Bulk-loss strips on all four edges absorb that waveguide mode. The
# on-axis shadow is then the cylinder's, not the plate-filled one.
#
# Scatterer: a PEC cylinder enforced by zeroing E_z each step inside
# the cylinder mask.
#
# Reference: ../../notebooks/11-fdtd-simulation.md.

mu0  = 4 * pi * 1e-7;
eps0 = 8.854187817e-12;
c0   = 1 / sqrt(mu0 * eps0);

# === Grid ===
# Sub-matrix slice-assigns vectorise the Yee step end-to-end (one
# expression per field component); no per-cell loops.
nx     = 81;
ny     = 61;
dx     = 7.5e-3;
dy     = dx;
S      = 0.7;
dt     = S * dx / c0;
n_step = 200;

# === Plane wave ===
f0     = 1.0e9;
omega  = 2 * pi * f0;
lambda = c0 / f0;
k0     = omega / c0;

# === PEC cylinder ===
# Radius 0.4 λ (16 cells) keeps the cylinder a few cells clear of the
# right absorbing strip and well away from the top/bottom walls.
[Xg, Yg] = meshgrid((1:nx) * dx, (1:ny) * dy);
xc = nx * dx * 0.6;
yc = ny * dy * 0.5;
R_pec = 0.4 * lambda;
pec_mask = disk_mask(Xg, Yg, xc, yc, R_pec);
inside_pec = 1 - pec_mask;            # 1 outside, 0 inside

# === Cheap absorbing strips on all four edges via bulk loss ===
# Cubic σ ramp: σ peaks at the outermost cell and tapers to zero at the
# inner edge of each strip. The top/bottom strips are narrower than the
# left/right ones so the cylinder (diameter ~32 cells) stays clear of them.
sigma_b   = 8 * eps0 * c0 / dx;
absorb_w  = 14;
absorb_wy = 8;
ramp      = (absorb_w:-1:1) / absorb_w;
ramp_y    = (absorb_wy:-1:1) / absorb_wy;
sig_x     = zeros(1, nx);
sig_y     = zeros(1, ny);
sig_x(1:absorb_w)              = sigma_b * ramp.^3;
sig_x(nx-absorb_w+1:nx)        = sigma_b * (ramp(absorb_w:-1:1)).^3;
sig_y(1:absorb_wy)             = sigma_b * ramp_y.^3;
sig_y(ny-absorb_wy+1:ny)       = sigma_b * (ramp_y(absorb_wy:-1:1)).^3;

# === Fields ===
Ez = zeros(ny, nx);
Hx = zeros(ny, nx);
Hy = zeros(ny, nx);

# Source location
j_src = 18;

# Update coefficients
cH = dt / (mu0 * dx);
cE = dt / (eps0 * dx);

# Implicit-loss damping. σ = σ_x(x) + σ_y(y); corners see both.
sig_xy   = repmat(sig_y.', 1, nx) + repmat(sig_x, ny, 1);
damp     = 1 ./ (1 + dt * sig_xy / (2 * eps0));
damp_int = damp(2:ny-1, 2:nx-1);

# === Shadow-depth probes ===
# Lee probe: on the beam axis (centre row), a couple of cells behind the
# cylinder's +x edge but still clear of the right absorbing strip.
# Lit probe: on the beam axis, in the illuminated region between the
# source column and the cylinder's front (-x) edge. The shadow depth is
# the ratio of the late-window lee amplitude to the lit amplitude.
i_axis = round(yc / dy);
j_lee  = round((xc + R_pec) / dx) + 2;
j_lit  = round((xc - R_pec) / dx) - 2;
E_lee_hist = zeros(1, n_step);
E_lit_hist = zeros(1, n_step);

figure();
for step = 1:n_step
  t = step * dt;

  # ---- H update (vectorised) ----
  Hx(1:ny-1, :) = Hx(1:ny-1, :) - cH * (Ez(2:ny, :) - Ez(1:ny-1, :));
  Hy(:, 1:nx-1) = Hy(:, 1:nx-1) + cH * (Ez(:, 2:nx) - Ez(:, 1:nx-1));

  # ---- E update (interior, with bulk-loss damping) ----
  curlH = (Hy(2:ny-1, 2:nx-1) - Hy(2:ny-1, 1:nx-2)) ...
        - (Hx(2:ny-1, 2:nx-1) - Hx(1:ny-2, 2:nx-1));
  Ez(2:ny-1, 2:nx-1) = damp_int .* (Ez(2:ny-1, 2:nx-1) + cE * curlH);

  # ---- CW soft line source on column j_src, updated rows only ----
  # Rows 1 and ny are never touched by the E update. Driving them
  # integrates the source (they climb to |E| ~ 10) and feeds a
  # parallel-plate mode between the PEC edges.
  src_amp = sin(omega * t) * (1 - exp(-(t / (15 * dt))^2));     # ramped CW
  Ez(2:ny-1, j_src) = Ez(2:ny-1, j_src) + src_amp;

  # ---- PEC: force E_z = 0 inside cylinder ----
  Ez = Ez .* inside_pec;

  # ---- Record shadow probes (lee vs lit, beam axis) ----
  E_lee_hist(step) = real(Ez(i_axis, j_lee));
  E_lit_hist(step) = real(Ez(i_axis, j_lit));

  if mod(step, 12) == 0
    imagesc(real(Ez), "viridis");
    title(sprintf("FDTD 2-D TMz — t / T = %.2f", t * f0));
    xlabel("x cell");
    ylabel("y cell");
    frame();
  end
end
saveanim("fdtd_2d_scattering.gif", 24);

# === Shadow depth (late CW window) ===
# Once the ramped CW has saturated, the lee probe sits in the cylinder's
# geometric shadow while the lit probe sees the incident + reflected
# standing wave. Their late-window amplitude ratio is the shadow depth.
win = round(0.7 * n_step):n_step;
shadow_abs  = max(abs(E_lee_hist(win)));
lit_max     = max(abs(E_lit_hist(win)));
shadow_norm = shadow_abs / lit_max;
print(shadow_abs)          # lee-probe |E_z| amplitude, late window
print(lit_max)             # lit-side |E_z| amplitude, late window
print(shadow_norm)         # shadow depth = lee / lit
# Source on rows 2:ny-1 with PEC top/bottom (no sig_y) gives ~0.049.
# The four-sided strips in this script remove the parallel-plate fill
# and the ratio drops to ~0.006. This print is the second of those.

# Final snapshot
figure();
imagesc(real(Ez), "viridis");
title("Final Re(E_z): plane wave + PEC cylinder shadow");
xlabel("x");
ylabel("y");
savefig("fdtd_2d_scattering_final.svg");

# Mask overlay for context
figure();
imagesc(pec_mask, "viridis");
title("PEC cylinder mask");
savefig("fdtd_2d_pec_mask.svg");
