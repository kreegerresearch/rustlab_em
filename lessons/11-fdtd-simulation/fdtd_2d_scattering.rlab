# fdtd_2d_scattering.rlab — TMz Yee FDTD in 2-D; plane wave scatters
# off a PEC cylinder; animated.
#
# Polarisation: TMz (E_z out of plane, H_x and H_y in plane).
#   E_z(i, j)   on integer cells i = 1..ny, j = 1..nx
#   H_x(i, j)   at (i + 0.5, j) — last row unused
#   H_y(i, j)   at (i,   j + 0.5) — last col unused
# Leapfrog:
#   H_x(i,j) -= (dt / mu0 / dy) [E_z(i+1,j) - E_z(i,j)]
#   H_y(i,j) += (dt / mu0 / dx) [E_z(i,j+1) - E_z(i,j)]
#   E_z(i,j) += (dt / eps0) [(H_y(i,j) - H_y(i,j-1))/dx
#                          - (H_x(i,j) - H_x(i-1,j))/dy]
# CFL: c0 dt ≤ Δ / √2 in 2-D.
#
# Source: a CW (continuous-wave) sinusoidal **line source** of E_z at
# column j_src — a soft source that emits a +x plane wave. The grid
# is bounded on left and right by a thick band of bulk-conductive
# absorbing cells (cheap stand-in for a full Bérenger PML); top and
# bottom are simply too far away to reflect within the run length.
#
# Scatterer: a PEC cylinder enforced by zeroing E_z each step inside
# the cylinder mask.
#
# Reference: ../../notebooks/11-fdtd-simulation.md.

mu0  = 4 * pi * 1e-7;
eps0 = 8.854187817e-12;
c0   = 1 / sqrt(mu0 * eps0);

# === Grid ===
# Per-cell for-loop updates run in interpreted rustlab; the grid /
# step count is sized so a single run lands well under a minute. A
# fully vectorised cat-rebuild Yee step is the natural follow-up.
nx     = 81;
ny     = 61;
dx     = 7.5e-3;
dy     = dx;
S      = 0.7;
dt     = S * dx / c0;
n_step = 200;

# === Plane wave ===
f0     = 1.0e9;
omega  = 2 * pi * f0;
lambda = c0 / f0;
k0     = omega / c0;

# === PEC cylinder ===
[Xg, Yg] = meshgrid((1:nx) * dx, (1:ny) * dy);
xc = nx * dx * 0.6;
yc = ny * dy * 0.5;
R_pec = 0.6 * lambda;
pec_mask = disk_mask(Xg, Yg, xc, yc, R_pec);
inside_pec = 1 - pec_mask;            # 1 outside, 0 inside

# === Cheap absorbing strips on left/right via bulk loss ===
sigma_b = 8 * eps0 * c0 / dx;
absorb_w = 14;
sig_x = zeros(1, nx);
for jj = 1:absorb_w
  x = (absorb_w - jj + 1) / absorb_w;
  sig_x(jj) = sigma_b * x^3;
  sig_x(nx - jj + 1) = sigma_b * x^3;
end
# Promote loss into a (ny, nx) map; eps becomes ε_r(1 + i σ/(ω ε₀))
eps_r_map = ones(ny, nx);
loss_factor = sig_x / (omega * eps0);   # row vector

# === Fields ===
Ez = zeros(ny, nx);
Hx = zeros(ny, nx);
Hy = zeros(ny, nx);

# Source location
j_src = 18;

# Update coefficients
cH = dt / (mu0 * dx);
cE = dt / (eps0 * dx);

figure();
for step = 1:n_step
  t = step * dt;

  # ---- H update (interior) ----
  for i = 1:ny-1
    for j = 1:nx
      Hx(i, j) = Hx(i, j) - cH * (Ez(i + 1, j) - Ez(i, j));
    end
  end
  for i = 1:ny
    for j = 1:nx-1
      Hy(i, j) = Hy(i, j) + cH * (Ez(i, j + 1) - Ez(i, j));
    end
  end

  # ---- E update with bulk loss in PML strips ----
  for i = 2:ny-1
    for j = 2:nx-1
      damp = 1 / (1 + dt * sig_x(j) / (2 * eps0));    # implicit-loss factor
      Ez(i, j) = damp * Ez(i, j) + damp * cE * ((Hy(i, j) - Hy(i, j - 1)) - (Hx(i, j) - Hx(i - 1, j)));
    end
  end

  # ---- CW soft line source on column j_src ----
  src_amp = sin(omega * t) * (1 - exp(-(t / (15 * dt))^2));     # ramped CW
  for i = 1:ny
    Ez(i, j_src) = Ez(i, j_src) + src_amp;
  end

  # ---- PEC: force E_z = 0 inside cylinder ----
  Ez = Ez .* inside_pec;

  if mod(step, 12) == 0
    imagesc(real(Ez), "viridis");
    title(sprintf("FDTD 2-D TMz — t / T = %.2f", t * f0));
    xlabel("x cell");
    ylabel("y cell");
    frame();
  end
end
saveanim("fdtd_2d_scattering.gif", 24);

# Final snapshot
figure();
imagesc(real(Ez), "viridis");
title("Final Re(E_z): plane wave + PEC cylinder shadow");
xlabel("x");
ylabel("y");
savefig("fdtd_2d_scattering_final.svg");

# Mask overlay for context
figure();
imagesc(pec_mask, "viridis");
title("PEC cylinder mask");
savefig("fdtd_2d_pec_mask.svg");
