# fdtd_1d.rlab — 1-D Yee FDTD: Gaussian pulse propagation through a
# dielectric slab; measure reflection vs the Fresnel formula.
#
# Yee staggered grid (1-D):
#   E_y on integer cells   k = 1 .. N
#   H_z on dual cells      Hz(k) lives at k + 1/2 (between Ey(k) and Ey(k+1))
# Leapfrog updates:
#   Hz(k) += -(dt / (mu0 dx)) [Ey(k+1) - Ey(k)]
#   Ey(k) += -(dt / (eps0 eps_r(k) dx)) [Hz(k) - Hz(k-1)]
# CFL stability: c0 dt ≤ dx (1-D).
#
# Source: soft (additive) Gaussian launched at one cell. The pulse
# splits into +x and -x running waves. The +x wave hits a dielectric
# slab (ε_r = 4 → n = 2, |R| analytic = 1/3) and partially reflects.
# Simple Mur first-order absorbing BCs at the ends hold up while
# c0 dt/dx ≈ 1.
#
# Reference: ../../notebooks/11-fdtd-simulation.md.

mu0  = 4 * pi * 1e-7;
eps0 = 8.854187817e-12;
c0   = 1 / sqrt(mu0 * eps0);

# === Grid + time step ===
N      = 601;
dx     = 1.0e-3;                     # 1 mm cells
S      = 0.99;                       # Courant number (<= 1)
dt     = S * dx / c0;
n_step = 1400;

# === Pulse parameters ===
t0  = 40 * dt;
tau = 12 * dt;

# === Material: vacuum + dielectric slab ===
eps_r = ones(1, N);
slab_lo = 350; slab_hi = 450;
for k = slab_lo:slab_hi; eps_r(k) = 4.0; end
n_slab = 2.0;

# === Sources & probes ===
k_src   = 150;                       # pulse origin
k_inc   = 200;                       # probe in air, before the slab
k_refl  = 250;                       # probe in air, also before slab
k_trans = 500;                       # probe in air, after slab

# === Fields ===
Ey = zeros(1, N);
Hz = zeros(1, N);                    # Hz(N) unused

# Pre-compute update coefficients.
cH  = dt / (mu0 * dx);
cE  = dt / (eps0 * dx);
cEr = cE ./ eps_r;                   # row vector, length N

# Records of probe-point Ey over time for R / T extraction.
E_inc_hist   = zeros(1, n_step);
E_refl_hist  = zeros(1, n_step);
E_trans_hist = zeros(1, n_step);

xs = (1:N) * dx;

figure();
for step = 1:n_step
  # H update on dual cells 1..N-1; concatenate with the (unchanged)
  # last cell so we end up with the same length-N row matrix.
  Hz = [Hz(1:N-1) - cH * (Ey(2:N) - Ey(1:N-1)), Hz(N)];

  # E update on interior cells 2..N-1.
  Ey = [Ey(1), Ey(2:N-1) - cEr(2:N-1) .* (Hz(2:N-1) - Hz(1:N-2)), Ey(N)];

  # Soft Gaussian source at k_src — additive via a delta vector keeps
  # the assignment vector-shaped on both sides.
  t = step * dt;
  src_val = exp(-((t - t0) / tau)^2);
  src_vec = zeros(1, N);
  src_vec(k_src) = src_val;
  Ey = Ey + src_vec;

  # Mur first-order ABC at the two ends (S ≈ 1 → trivial copy).
  Ey(1) = Ey(2);
  Ey(N) = Ey(N - 1);

  # Probes.
  E_inc_hist(step)   = real(Ey(k_inc));
  E_refl_hist(step)  = real(Ey(k_refl));
  E_trans_hist(step) = real(Ey(k_trans));

  if mod(step, 25) == 0
    hold on;
    plot(xs * 1000, real(Ey), "E_y(x,t)");
    plot([slab_lo, slab_lo, slab_hi, slab_hi] * dx * 1000, [-1.5, 1.5, 1.5, -1.5], "slab");
    hold off;
    xlim([0.0, N * dx * 1000]);
    ylim([-1.5, 1.5]);
    xlabel("x  (mm)");
    title(sprintf("FDTD 1-D — t = %.2f ns", t * 1e9));
    frame();
  end
end
saveanim("fdtd_1d_pulse.gif", 24);

# === R and T amplitude extraction ===
# A soft Gaussian source splits in two: half goes +x, half goes -x.
# So the +x-going *incident* peak at k_inc is half the source peak.
#
# The slab between cells 350-450 has two interfaces. For a thick,
# loss-less slab the combined E-amplitude transmission through both
# interfaces is t1·t2 = (2n1/(n1+n2))(2n2/(n1+n2)) = 8/9 ≈ 0.889
# (Fabry-Perot bounces aside, which arrive at the trans probe later).
A_inc   = max(abs(E_inc_hist));
A_trans = max(abs(E_trans_hist));
print(A_inc)               # ~ 0.5 (half of unit Gaussian source)
print(A_trans)             # ~ A_inc * 8/9 — first transmitted lobe
print(A_trans / A_inc)     # ~ 8/9 ≈ 0.889

# === Static traces plot ===
figure();
ts = (1:n_step) * dt;
hold on;
plot(ts * 1e9, E_inc_hist,   "probe @ inc");
plot(ts * 1e9, E_refl_hist,  "probe @ refl");
plot(ts * 1e9, E_trans_hist, "probe @ trans");
hold off;
xlabel("t  (ns)");
ylabel("E_y at probe");
title("Probe traces: incident, reflected, transmitted");
legend("inc", "refl", "trans");
savefig("fdtd_1d_probes.svg");

# === Final snapshot ===
figure();
plot(xs * 1000, real(Ey), "E_y(x, t_final)");
xlabel("x  (mm)");
ylabel("E_y");
title("Field at end of run — reflected + transmitted pulses");
savefig("fdtd_1d_final.svg");
