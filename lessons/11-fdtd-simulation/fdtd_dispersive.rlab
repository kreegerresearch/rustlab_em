# fdtd_dispersive.rlab — 1-D FDTD pulse through a thin Drude-metal
# film via an auxiliary differential equation (ADE).
#
# Drude permittivity:
#   ε(ω) = ε_∞ − ω_p² / (ω² + i γ ω)
# In the time domain the polarisation current J_p obeys
#   dJ_p/dt + γ J_p = ε_0 ω_p² E
# discretised at half-step using a simple trapezoidal update:
#   J_p^{n+1/2} = (1 − γ dt/2)/(1 + γ dt/2) · J_p^{n-1/2}
#               + (ε_0 ω_p² dt / (1 + γ dt/2)) · E^n
# (A one-step explicit-Euler form J_p^{n+1} = (1 − γ dt) J_p^n
#  + ε_0 ω_p² dt E^n is NOT used: for γ = 0 the E–J_p oscillator's
#  amplitude would grow by |1 − i ω_p dt| = sqrt(1 + ω_p² dt²) > 1
#  every step.)
# The Ampère update then sees an extra current term:
#   E^{n+1}(i) = E^n(i) − (dt/ε_0)/dx · [Hz(i) − Hz(i-1)]  − (dt/ε_0) · J_p(i)
# (the ε_∞ scaling is absorbed into ε_0 since ε_∞ ≈ 1 for the Drude
# region; for ε_∞ ≠ 1 divide the bracketed term by ε_∞.)
#
# Parameters: real Drude gold has ω_p / 2π ≈ 2.18 PHz (a plasma
# wavelength near 140 nm). We rescale to comfortable curriculum-scale
# GHz values rather than gold's exact numbers — the qualitative effect
# (transmission above ω_p, evanescent decay below ω_p) is the point.
#
# Reference: ../../notebooks/11-fdtd-simulation.md.

mu0  = 4 * pi * 1e-7;
eps0 = 8.854187817e-12;
c0   = 1 / sqrt(mu0 * eps0);

# === Curriculum-scale Drude parameters ===
# Plasma frequency 3 GHz keeps ω_p dt = 0.094 (well inside the
# staggered-ADE stability bound ω_p dt ≤ 2) and γ = 1 GHz · 2π keeps
# the metal lossy enough that propagating modes don't accumulate.
fp      = 3.0e9;
gamma   = 2 * pi * 1.0e9;
omega_p = 2 * pi * fp;

# === Grid ===
N       = 801;
dx      = 1.5e-3;
S       = 0.99;
dt      = S * dx / c0;
n_step  = 2000;

# Metal film: cells 380..420 (40 cells, ~ 6 cm thick)
film_lo = 380; film_hi = 420;
# Single-arg `zeros(N)` returns a 1-D Vector — needed for the slice-
# assigning leapfrog below (vector RHS into a Matrix slice is rejected).
in_film = zeros(N);
in_film(film_lo:film_hi) = 1.0;

# === Fields ===
Ey = zeros(N);
Hz = zeros(N);
Jp = zeros(N);     # polarisation current — non-zero only inside metal

# === Source: Gaussian pulse modulated at f_mod = 2 GHz ===
# The carrier (2 GHz) sits below f_p = ω_p/2π (3 GHz), so the film is
# evanescent and the post-film probe sees a strongly attenuated trace.
# Exercise 4 lifts f_mod above f_p (5 GHz) to watch transmission
# recover to ~0.63.
t0    = 80 * dt;
tau   = 25 * dt;
f_mod = 2.0e9;
k_src = 100;
k_probe_back = 200;       # before film
k_probe_fwd  = 600;       # after film

cH = dt / (mu0 * dx);
cE = dt / (eps0 * dx);
# Centred-difference (trapezoidal) ADE update keeps the explicit Yee
# stable: J_p^{n+1/2} = α J_p^{n-1/2} + β E^n.  Explicit Euler on the
# E-J_p oscillator is unstable for γ = 0 — its amplitude grows by
# sqrt(1 + ω_p² dt²) per step (finite γ can mask but not fix it);
# this form is stable as long as ω_p dt ≤ 2 (Drude's analogue of CFL).
ade_decay = (1 - gamma * dt / 2) / (1 + gamma * dt / 2);
ade_drive = eps0 * omega_p^2 * dt   / (1 + gamma * dt / 2);

E_back_hist = zeros(n_step);
E_fwd_hist  = zeros(n_step);

for step = 1:n_step
  t = step * dt;

  # H update
  Hz(1:N-1) = Hz(1:N-1) - cH * (Ey(2:N) - Ey(1:N-1));

  # ADE update for J_p (only inside metal — `in_film` mask zeros it elsewhere)
  Jp = ade_decay * Jp + ade_drive * Ey .* in_film;

  # Save boundary-adjacent values at time level n for the Mur ABC.
  Ey_l_old = Ey(2);
  Ey_r_old = Ey(N - 1);

  # E update: standard Ampère term minus the polarisation-current term
  Ey(2:N-1) = Ey(2:N-1) - cE * (Hz(2:N-1) - Hz(1:N-2)) - (dt / eps0) * Jp(2:N-1);

  # Source: modulated Gaussian
  src_amp = exp(-((t - t0) / tau)^2) * cos(2 * pi * f_mod * (t - t0));
  Ey(k_src) = Ey(k_src) + src_amp;

  # Mur first-order ABC at the ends: one-step-DELAYED copy
  # E^{n+1}(1) = E^n(2) (same-time copy would be a Neumann reflector).
  Ey(1) = Ey_l_old;
  Ey(N) = Ey_r_old;

  E_back_hist(step) = real(Ey(k_probe_back));
  E_fwd_hist(step)  = real(Ey(k_probe_fwd));
end

# === Plot probe traces ===
ts = (1:n_step) * dt;
figure();
hold on;
plot(ts * 1e9, E_back_hist, "before film");
plot(ts * 1e9, E_fwd_hist,  "after film");
hold off;
xlabel("t  (ns)");
ylabel("E_y");
title("Pulse through Drude film — pre and post field");
legend("before film", "after film");
savefig("fdtd_dispersive_probes.svg");

# === FFT comparison ===
# Take a window after the pulse has fully passed and FFT both traces.
# Ratio of magnitude spectra gives the transmission spectrum.
# Skip burn-in; use late portion of trace for both.
start_w = 500;
Eb = E_back_hist(start_w:n_step);
Ef = E_fwd_hist(start_w:n_step);
Sb = abs(fft(Eb));
Sf = abs(fft(Ef));
Nw = length(Eb);
fs = (0:Nw-1) / (Nw * dt);
half_w = round(Nw / 2);

# Normalise transmission by the incident spectrum (Eb sees inc+refl;
# this is rough — for a clean T-spectrum a separate reference run
# without film is the textbook approach).
Trans = Sf(1:half_w) ./ (Sb(1:half_w) + 1e-12);

figure();
plot(fs(1:half_w) / 1e9, Trans, "T(f) (rough)");
xlim([0.0, 20.0]);
xlabel("frequency  (GHz)");
ylabel("|E_fwd / E_back|");
title(sprintf("Drude metal — plasma frequency fp = %.0f GHz", fp / 1e9));
savefig("fdtd_dispersive_transmission.svg");

print(fp / 1e9)             # 3 — expected plasma frequency
print(max(abs(E_fwd_hist))) # ~ 0.101 — transmitted-pulse peak
print(max(abs(E_back_hist)))# ~ 0.505 — incident-side peak (ratio ~ 0.20)
