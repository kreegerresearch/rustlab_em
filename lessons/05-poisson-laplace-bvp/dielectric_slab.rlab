# dielectric_slab.rlab — Capacitor with εr = 4 slab filling half the gap.
#
# Geometry:   5 mm × 10 mm grid, Neumann sides for a 1-D-like solution.
#             Bottom plate (y = 0) at V = 0; top plate (y = 10 mm) at V = 1.
#             Lower half is dielectric (εr = 4); upper half is vacuum.
# PDE:        ∇·(ε ∇V) = 0  with harmonic-mean half-cell coefficients.
# Method:     laplacian_eps_2d + spsolve, with top/bottom rows pinned.
#
# Verifies:   field jump E_air / E_diel = εr exactly,
#             D = ε ε₀ E continuous across the interface,
#             C/A = ε₀ / (d_air + d_diel/εr) — series-capacitor formula.
#
# Reference: ../../notebooks/05-poisson-laplace-bvp.md.

set_default_axis("xy");        # physics y-axis for every imagesc panel below

# === Grid ===
nxd = 21; nyd = 81;
Lxd = 0.005; Lyd = 0.010;
dxd = Lxd / (nxd - 1);
dyd = Lyd / (nyd - 1);
xsd = linspace(0, Lxd, nxd);
ysd = linspace(0, Lyd, nyd);
[Xd, Yd] = meshgrid(xsd, ysd);
j_mid = (nxd + 1) / 2;         # centre column (x = 2.5 mm) — nxd = 21 → 11

# === Permittivity map ===
# Bottom half (y < Ly/2) is the ε_r = 4 dielectric; top half is air.
eps_map = ones(nyd, nxd);
i_half  = sum(ysd < Lyd / 2);
eps_map(1:i_half, :) = 4.0;

figure();
imagesc(eps_map, "viridis");
title("eps_r(x, y): 4 below the interface, 1 above");
savefig("dielectric_eps_map.svg");

# === Sparse system with Neumann sides ===
L_eps = laplacian_eps_2d(eps_map, dxd, dyd, "neumann");
A_d = -1 * L_eps;
n_d = nxd * nyd;
b_d = zeros(1, n_d);

for j = 1:nxd
  k_top = ij2k(nyd, j, nyd);
  A_d(k_top, k_top) = 1.0;
  A_d(k_top, ij2k(nyd - 1, j, nyd)) = 0.0;
  if j > 1;   A_d(k_top, ij2k(nyd, j - 1, nyd)) = 0.0; end
  if j < nxd; A_d(k_top, ij2k(nyd, j + 1, nyd)) = 0.0; end
  b_d(1, k_top) = 1.0;
  k_bot = ij2k(1, j, nyd);
  A_d(k_bot, k_bot) = 1.0;
  A_d(k_bot, ij2k(2, j, nyd)) = 0.0;
  if j > 1;   A_d(k_bot, ij2k(1, j - 1, nyd)) = 0.0; end
  if j < nxd; A_d(k_bot, ij2k(1, j + 1, nyd)) = 0.0; end
  b_d(1, k_bot) = 0.0;
end

V_flat = spsolve(A_d, b_d);
V_d = real(reshape(V_flat, nyd, nxd));

figure();
plot(ysd * 1000, V_d(:, j_mid), "V(y) at the centre column");
xlabel("y (mm)");
ylabel("V (V)");
savefig("dielectric_V_profile.svg");

# === Field, displacement, capacitance ===
[Exd, Eyd] = gradient(V_d, dxd, dyd);
Eyd = -Eyd;

i_diel = 21;               # mid-dielectric (y = 2.5 mm exactly)
i_air  = 61;               # mid-air (y = 7.5 mm exactly)
print(abs(real(Eyd(i_diel, j_mid))))    # ≈ 40 V/m  in eps=4
print(abs(real(Eyd(i_air,  j_mid))))    # ≈ 159 V/m in eps=1
print(real(Eyd(i_air, j_mid)) / real(Eyd(i_diel, j_mid)))   # → 4 exactly

eps0 = 8.8541878128e-12;
D_diel = eps0 * 4.0 * real(Eyd(i_diel, j_mid));
D_air  = eps0 * 1.0 * real(Eyd(i_air,  j_mid));
print(real(D_diel))                        # ≈ -1.41e-9
print(real(D_air))                         # same to six digits — D continuity

# Series-capacitor analytic vs numerical
d_air  = Lyd / 2;
d_diel = Lyd / 2;
C_an   = eps0 / (d_air + d_diel / 4.0);
sigma_top = -eps0 * real(Eyd(nyd - 1, j_mid));
C_num  = abs(sigma_top) / 1.0;
print(real(C_an))                          # ≈ 1.42e-9 F/m²
print(real(C_num))                         # matches analytic to ~10⁻²
