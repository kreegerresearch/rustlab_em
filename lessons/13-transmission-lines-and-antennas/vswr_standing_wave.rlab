# vswr_standing_wave.rlab — CW excitation of a terminated line, with
# the resulting standing-wave envelope and VSWR measurement.
#
# Setup:    50 Ω lossless line, length 0.5 m, driven at the left end
# with a CW source at 1 GHz, terminated on the right with a resistor
# Z_L = 2 Z₀ = 100 Ω. Reflection coefficient |Γ| = 1/3; VSWR = 2.
# After ~ 5 round trips the field settles into a standing wave whose
# envelope |V(z)|_max / |V(z)|_min equals the analytic VSWR.
#
# Reference: ../../notebooks/13-transmission-lines-and-antennas.md.

mu0 = 4 * pi * 1e-7;
eps0 = 8.854187817e-12;
c0   = 1 / sqrt(mu0 * eps0);

# === TL parameters ===
Z0    = 50.0;
v_prop = c0;
L_pul = Z0 / v_prop;
C_pul = 1 / (Z0 * v_prop);
Z_L   = 2 * Z0;
Gamma_ana = (Z_L - Z0) / (Z_L + Z0);
VSWR_ana  = (1 + abs(Gamma_ana)) / (1 - abs(Gamma_ana));
print(Gamma_ana)        # +1/3
print(VSWR_ana)         # 2

# === Grid ===
N   = 401;
dz  = 1e-3;
S   = 0.95;
dt  = S * dz / v_prop;

f0      = 1.0e9;
omega   = 2 * pi * f0;
n_step  = 6000;          # long enough for steady state

V = zeros(1, N);
Iv = zeros(1, N);

# Track the |V(z)| **envelope** = max over time of |V(z, t)|. For a
# steady-state standing wave the temporal min is zero at every cell,
# so we extract the spatial VSWR from the envelope alone.
V_env = linspace(0, 0, N);

watch_from = round(0.75 * n_step);

for step = 1:n_step
  t = step * dt;
  Iv = [Iv(1), Iv(2:N) - (dt / (L_pul * dz)) * (V(2:N) - V(1:N-1))];
  V_int = V(1:N-1) - (dt / (C_pul * dz)) * (Iv(2:N) - Iv(1:N-1));

  # Load: I_load = V(N) / Z_L
  I_load = V(N) / Z_L;
  V_N_new = V(N) - (dt / (C_pul * dz)) * (I_load - Iv(N));
  V = [V_int, V_N_new];

  # CW source with smooth ramp-on (avoid spectral leakage)
  ramp = 1 - exp(-(t / (40 * dt))^2);
  src_val = ramp * sin(omega * t);
  src_vec = zeros(1, N);
  src_vec(1) = src_val;
  V = V + src_vec;

  # No left ABC — let the source dominate
  if step > watch_from
    av = abs(real(V));
    V_env = (V_env + av + abs(V_env - av)) / 2;     # elementwise max
  end
end

zs = (1:N) * dz;

# VSWR from the spatial envelope, skipping the leftmost few cells
# where the source itself dominates the field.
window = 20:(N - 5);
Vmax_z = max(V_env(window));
Vmin_z = min(V_env(window));
VSWR_num = Vmax_z / Vmin_z;
Gamma_num = (VSWR_num - 1) / (VSWR_num + 1);
print(VSWR_num)              # ~ 2
print(Gamma_num)             # ~ 1/3

figure();
plot(zs * 1000, V_env, "|V|_env(z)");
xlabel("z  (mm)");
ylabel("|V|_env");
title(sprintf("Standing-wave envelope — VSWR_num = %.3f vs analytic = %.3f", VSWR_num, VSWR_ana));
savefig("tline_vswr.svg");
