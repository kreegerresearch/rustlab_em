# telegrapher_propagation.rlab — Pulse propagation on a lossless
# transmission line via the 1-D staggered telegrapher leapfrog.
#
# Telegrapher equations on a TL with per-unit-length L', C':
#   ∂V/∂z = -L' ∂I/∂t
#   ∂I/∂z = -C' ∂V/∂t
# Phase velocity v = 1/sqrt(L'C'), characteristic impedance Z₀ = sqrt(L'/C').
# CFL: dt ≤ dx / v.
#
# Discretisation (Yee-like staggered grid in (z, t)):
#   V on integer cells z = (k-1) dz
#   I on half cells   z = (k-1/2) dz, so I(k) sits between V(k-1) and V(k)
# Leapfrog updates:
#   I(k) ← I(k) − (Δt / (L' dz)) · (V(k) − V(k-1))     for k = 2..N
#   V(k) ← V(k) − (Δt / (C' dz)) · (I(k+1) − I(k))     for k = 1..N-1
#
# Reflections at the load end Z_L:
#   Γ = (Z_L − Z₀) / (Z_L + Z₀)
#   - matched   Z_L = Z₀  → Γ = 0    (no reflection)
#   - open      Z_L = ∞   → Γ = +1   (V doubles, I → 0)
#   - short     Z_L = 0   → Γ = −1   (V → 0, I doubles)
#   - mismatch  Z_L = 2 Z₀ → Γ = +1/3
#
# Reference: ../../notebooks/13-transmission-lines-and-antennas.md.

# === Per-unit-length parameters (50 Ω vacuum-loaded coax-like line) ===
mu0  = 4 * pi * 1e-7;
eps0 = 8.854187817e-12;
c0   = 1 / sqrt(mu0 * eps0);

Z0     = 50.0;
v_prop = c0;
L_pul  = Z0 / v_prop;            # H/m
C_pul  = 1 / (Z0 * v_prop);      # F/m

# === Grid ===
N   = 401;
dz  = 1e-3;
S   = 0.95;
dt  = S * dz / v_prop;
n_step = 1200;

# === Source — Gaussian pulse on the V end ===
t0  = 30 * dt;
tau = 8 * dt;

# === Termination cases ===
# Encode each as a per-step boundary update on V(N).
# - Z_L = Z₀ (matched): one-way absorbing — V(N) ← V(N-1)
# - open (Z_L = ∞):     I(N+1) = 0, i.e. V(N) ← V(N) − (Δt/(C' dz)) · (0 − I(N))
# - short (Z_L = 0):    V(N) ← 0
# - Z_L = 2 Z₀:         I(N+1) = V(N) / Z_L; V update with this I term.
#
# Run all four cases sequentially and overlay |V(z)| snapshots.

function V_out = run_tline(load_kind, Z_L)
  mu0_l  = 4 * pi * 1e-7;
  eps0_l = 8.854187817e-12;
  c0_l   = 1 / sqrt(mu0_l * eps0_l);
  Z0_l = 50.0;
  v_l = c0_l;
  L_l = Z0_l / v_l;
  C_l = 1 / (Z0_l * v_l);

  # Run long enough for the reflected pulse to return to the source
  # region, but short enough that it hasn't yet exited through the
  # left Mur ABC.
  N_l   = 401;
  dz_l  = 1e-3;
  dt_l  = 0.95 * dz_l / v_l;
  n_step_l = 780;

  V = zeros(1, N_l);
  Iv = zeros(1, N_l);                # I(k) at half-cell between V(k-1) and V(k); I(1) unused

  t0_l = 30 * dt_l;
  tau_l = 8 * dt_l;
  k_src = 30;

  for step = 1:n_step_l
    V2_prev = V(2);              # pre-update neighbour for the delayed-copy Mur ABC
    # I update: I(2:N) ← I(2:N) − (Δt/(L' dz)) (V(2:N) − V(1:N-1))
    Iv = [Iv(1), Iv(2:N_l) - (dt_l / (L_l * dz_l)) * (V(2:N_l) - V(1:N_l-1))];
    # V update: V(1:N-1) ← V(1:N-1) − (Δt/(C' dz)) (I(2:N) − I(1:N-1))
    V_int = V(1:N_l-1) - (dt_l / (C_l * dz_l)) * (Iv(2:N_l) - Iv(1:N_l-1));

    # Load: V(N) update with I_load = V(N) / Z_L flowing through the
    # termination at z = N · dz. Special-case the short (Z_L = 0)
    # which would otherwise divide by zero.
    if load_kind == 3
      V_N_new = 0;
    else
      I_load = V(N_l) / Z_L;
      V_N_new = V(N_l) - (dt_l / (C_l * dz_l)) * (I_load - Iv(N_l));
    end

    V = [V_int, V_N_new];

    # Soft source
    t = step * dt_l;
    src_val = exp(-((t - t0_l) / tau_l)^2);
    src_vec = zeros(1, N_l);
    src_vec(k_src) = src_val;
    V = V + src_vec;

    # Left-end Mur ABC (delayed copy): V^{n+1}(1) = V^n(2) lets the
    # back-going pulse out (a same-step copy would be a reflecting
    # Neumann wall).
    V(1) = V2_prev;
  end
  V_out = V;
end

V_match = run_tline(1, 50);
V_open  = run_tline(2, 1e12);
V_short = run_tline(3, 0);
V_mis   = run_tline(4, 100);     # Z_L = 2 Z₀, Γ = +1/3

zs = (1:N) * dz;

figure();
hold on;
plot(zs * 1000, real(V_match), "matched (Γ = 0)");
plot(zs * 1000, real(V_open),  "open (Γ = +1)");
plot(zs * 1000, real(V_short), "short (Γ = -1)");
plot(zs * 1000, real(V_mis),   "Z_L = 2 Z₀ (Γ = +1/3)");
hold off;
xlabel("z  (mm)");
ylabel("V(z) at end of run");
title("1-D telegrapher leapfrog — load reflections after pulse return");
legend("matched", "open", "short", "Z_L = 2 Z₀");
savefig("tline_reflections.svg");

# Peak |V| of the reflected pulse near the source — proxy for |Γ|.
# Window cells 20-80 (around source) for the *second* peak.
print("--- Reflection check ---")
print(max(abs(real(V_match(20:80)))))     # ~ 0 (matched)
print(max(abs(real(V_open(20:80)))))      # ~ source peak (Γ = +1)
print(max(abs(real(V_short(20:80)))))     # ~ source peak (Γ = -1, sign flip)
print(max(abs(real(V_mis(20:80)))))       # ~ source_peak / 3 (Γ = +1/3)
