# s_parameters_tline.rlab — Extract S₁₁ and S₂₁ of a two-section
# transmission line with an impedance step via 1-D FDTD + FFT.
#
# Layout (single dielectric, so v is the same throughout; only Z₀
# changes via the L'/C' ratio):
#
#   [ABC] --- Z_0,1 = 50 Ω --- | --- Z_0,2 = 100 Ω --- [matched load]
#         src         probe1     junction        probe2
#
# Drive a Gaussian voltage pulse at the source. Two runs:
#   1. Reference: uniform Z_0,1 everywhere (no junction). Probe1 sees
#      the clean incident pulse V_inc(t).
#   2. With step: same source, junction at k_mid. Probe1 sees the
#      incident plus the reflected pulse; probe2 (well past the
#      junction) sees only the transmitted pulse.
# Then
#   V_refl(t) = V_step(t, p1) − V_ref(t, p1)
#   V_trans(t) = V_step(t, p2)
# and the scattering parameters are
#   S₁₁(f) = FFT(V_refl) / FFT(V_inc)
#   S₂₁(f) = FFT(V_trans) / FFT(V_inc) · sqrt(Z_0,1 / Z_0,2)
# The √(Z_0,1/Z_0,2) corrects for the port-impedance normalisation of
# scattering parameters (power waves, not voltage waves).
#
# Analytic verification at the impedance step:
#   Γ  = (Z_0,2 − Z_0,1) / (Z_0,2 + Z_0,1)        (voltage)
#   |S₁₁| = |Γ|
#   |S₂₁| = 2 √(Z_0,1 Z_0,2) / (Z_0,1 + Z_0,2)
#   |S₁₁|² + |S₂₁|² = 1                           (lossless)
#
# For Z_0,1 = 50 Ω, Z_0,2 = 100 Ω: Γ = 1/3, |S₂₁| = (2√5000)/150 ≈ 0.943.
#
# Reference: ../../notebooks/13-transmission-lines-and-antennas.md.

mu0  = 4 * pi * 1e-7;
eps0 = 8.854187817e-12;
c0   = 1 / sqrt(mu0 * eps0);

# === Common parameters ===
Z01    = 50.0;
Z02    = 100.0;
v_prop = c0;
N      = 801;
dz     = 1e-3;
# Magic time step (S = 1) gives zero numerical dispersion in 1-D, so
# the reflected pulse has the *same* shape as the incident and the
# FFT magnitude ratio reproduces |Γ| across the in-band bins to ~0.1 %
# (the residual comes from the extraction, not dispersion).
S_cfl  = 1.0;
dt     = S_cfl * dz / v_prop;
n_step = 1500;
k_src  = 50;                     # source cell
k_p1   = 220;                    # probe in section 1 — sees inc then refl
k_mid  = 400;                    # impedance step
k_p2   = 600;                    # probe in section 2 — sees trans only
# Modulated Gaussian: carrier at f_c puts the spectral peak in a clean
# passband around 5 GHz where the wavelength is 60 cells (well resolved
# by dz = 1 mm). The envelope width τ = 18 dt gives ~3 GHz two-sided
# bandwidth.
f_c    = 5e9;
t0     = 80 * dt;
tau    = 18 * dt;

# Per-cell L'/C' arrays for uniform and stepped lines.
# Use a Vector (single-arg zeros/ones) so slice-assign with vector RHS
# works on the cat-rebuild leapfrog.
function [L_arr, C_arr] = build_line(N, Z01, Z02, v, k_mid, kind)
  L_arr = ones(N) * (Z01 / v);
  C_arr = ones(N) * (1 / (Z01 * v));
  if kind > 1
    L_arr(k_mid:N) = Z02 / v;
    C_arr(k_mid:N) = 1 / (Z02 * v);
  end
end

function [V_p1, V_p2] = run_line(L_arr, C_arr, Z_load, n_step, dz, dt, ...
                                  k_src, k_p1, k_p2, t0, tau, f_c)
  N = length(L_arr);
  V   = zeros(N);
  Iv  = zeros(N);                # I(k) at half-cell between V(k-1) and V(k); I(1) unused
  V_p1 = zeros(n_step);
  V_p2 = zeros(n_step);
  for step = 1:n_step
    V2_prev = V(2);            # pre-update neighbour for the delayed-copy Mur ABC
    # I update (vectorised slice-assign).
    Iv(2:N) = Iv(2:N) - (dt ./ (L_arr(2:N) * dz)) .* (V(2:N) - V(1:N-1));
    # V update on interior cells.
    V(1:N-1) = V(1:N-1) - (dt ./ (C_arr(1:N-1) * dz)) .* (Iv(2:N) - Iv(1:N-1));
    # Matched load at right end via the load-current ghost-cell trick.
    I_load = V(N) / Z_load;
    V(N) = V(N) - (dt / (C_arr(N) * dz)) * (I_load - Iv(N));
    # Modulated Gaussian soft source on V at k_src.
    t = step * dt;
    V(k_src) = V(k_src) + exp(-((t - t0) / tau) ^ 2) * cos(2 * pi * f_c * (t - t0));
    # Mur first-order ABC on the left edge (delayed copy: V^{n+1}(1) = V^n(2);
    # a same-step copy would be a reflecting Neumann wall).
    V(1) = V2_prev;
    V_p1(step) = real(V(k_p1));
    V_p2(step) = real(V(k_p2));
  end
end

# === Reference run (uniform Z_0,1, no junction) ===
[L_u, C_u] = build_line(N, Z01, Z02, v_prop, k_mid, 1);
[V_p1_u, V_p2_u] = run_line(L_u, C_u, Z01, n_step, dz, dt, ...
                            k_src, k_p1, k_p2, t0, tau, f_c);

# === Stepped-impedance run ===
[L_s, C_s] = build_line(N, Z01, Z02, v_prop, k_mid, 2);
[V_p1_s, V_p2_s] = run_line(L_s, C_s, Z02, n_step, dz, dt, ...
                            k_src, k_p1, k_p2, t0, tau, f_c);

# Incident (clean) at probe1, reflected (subtracted), transmitted at probe2.
V_inc   = V_p1_u;
V_refl  = V_p1_s - V_p1_u;
V_trans = V_p2_s;

# === Analytic two-port reference ===
Gamma_ana = (Z02 - Z01) / (Z02 + Z01);
S21_ana   = 2 * sqrt(Z01 * Z02) / (Z01 + Z02);
print(abs(Gamma_ana))               # 1/3
print(S21_ana)                      # ~ 0.9428
print(abs(Gamma_ana) ^ 2 + S21_ana ^ 2)   # ≈ 1 (energy conservation)

# === Time-domain S-parameters via peak amplitudes ===
# A modulated Gaussian pulse with a clean carrier is essentially a
# narrowband probe at f_c. The peak voltage amplitudes give the
# scattering parameters directly:
#   |S₁₁| ≈ |V_refl,pk| / |V_inc,pk|
#   |S₂₁| ≈ |V_trans,pk| / |V_inc,pk| · sqrt(Z₀,1 / Z₀,2)
# This is the "robust" extraction — independent of FFT subtleties.
V_inc_pk   = max(abs(V_inc));
V_refl_pk  = max(abs(V_refl));
V_trans_pk = max(abs(V_trans));
S11_td = V_refl_pk / V_inc_pk;
S21_td = V_trans_pk / V_inc_pk * sqrt(Z01 / Z02);
print(S11_td)                       # ≈ 0.333
print(S21_td)                       # ≈ 0.943

# === FFT-based S-parameters ===
# Broadband S-param extraction would average over many frequencies.
# Here the source has a narrow spectrum centred at f_c; reporting the
# FFT magnitude at the bin closest to f_c gives a single-frequency
# comparison to the time-domain result. At the magic time step (S = 1)
# there is no numerical dispersion in 1-D, so the reflected/transmitted
# pulses keep the incident shape exactly and this FFT ratio reproduces
# |Gamma| to ~0.1 % — sharper than the time-domain peak ratio. Break
# S = 1 (Exercise 2) and dispersion reshapes the pulses; only then does
# tapering the sharp junction over a handful of cells start to matter.
F_inc   = fft(V_inc);
F_refl  = fft(V_refl);
F_trans = fft(V_trans);
N_fft   = length(F_inc);
fs      = (0:N_fft-1) / (N_fft * dt);

S11_mag = abs(F_refl  ./ (F_inc + 1e-30));
S21_mag = abs(F_trans ./ (F_inc + 1e-30)) * sqrt(Z01 / Z02);

k_pick  = argmin(abs(fs - f_c));
print(fs(k_pick) / 1e9)             # ~ f_c in GHz (nearest bin ≈ 5.00)
print(real(S11_mag(k_pick)))        # 0.3337 — matches |Gamma| = 1/3 to ~0.1 %
print(real(S21_mag(k_pick)))        # 0.9427 — matches 2√(Z1 Z2)/(Z1+Z2)

# === Plots ===
N_half = round(N_fft / 2);
fs_ghz = fs(1:N_half) / 1e9;

figure();
hold on;
plot(fs_ghz, real(S11_mag(1:N_half)), "|S_11(f)|");
plot(fs_ghz, real(S21_mag(1:N_half)), "|S_21(f)|");
hold off;
xlim([0.0, 50.0]);
ylim([0.0, 1.2]);
xlabel("frequency (GHz)");
ylabel("|S|");
title("S-parameters from 1-D FDTD of a 50→100 Ω step");
legend("|S_11|", "|S_21|");
yline(abs(Gamma_ana));
yline(S21_ana);
savefig("s_params_magnitude.svg");

figure();
hold on;
plot((1:n_step) * dt * 1e9, V_inc,   "V_inc (ref)");
plot((1:n_step) * dt * 1e9, V_refl,  "V_refl (step − ref)");
plot((1:n_step) * dt * 1e9, V_trans, "V_trans (probe2)");
hold off;
xlabel("t  (ns)");
ylabel("V");
title("Time-domain waveforms used for S-parameter extraction");
legend("V_inc", "V_refl", "V_trans");
savefig("s_params_waveforms.svg");
