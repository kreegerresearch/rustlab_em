# mutual_inductance.rlab — M for concentric coplanar loops.
#
# Geometry:   outer loop radius b = 0.10 m (current I1 = 1 A, in xy-plane),
#             inner loop radius a = 0.02 m (also in xy-plane, concentric).
# Method:     numerical Biot-Savart for Bz from the outer loop on a 41×41
#             grid covering the inner-loop disk; integrate over cells with
#             x² + y² ≤ a² to get Φ; M = Φ / I1.
# Verifies:   small-a/b limit M ≈ μ₀ π a² / (2 b).
#
# Reference: ../../notebooks/07-faraday-induction.md.

mu0 = 4 * pi * 1e-7;
I1  = 1.0;
b_o = 0.10;
a_i = 0.02;

# Outer-loop discretization
N_seg = 200;
phi   = linspace(0, 2*pi, N_seg + 1);
phi   = phi(1:N_seg);
dphi  = 2 * pi / N_seg;
rxs   = b_o * cos(phi);
rys   = b_o * sin(phi);
rzs   = zeros(N_seg);
dlx   = -b_o * sin(phi) * dphi;
dly   =  b_o * cos(phi) * dphi;
dlz   = zeros(N_seg);

# Field grid covering the inner disk
Ng  = 41;
xs2 = linspace(-1.5 * a_i, 1.5 * a_i, Ng);
ys2 = linspace(-1.5 * a_i, 1.5 * a_i, Ng);
[Xg, Yg] = meshgrid(xs2, ys2);
dxg = xs2(2) - xs2(1);
dyg = ys2(2) - ys2(1);

Bz_grid = zeros(Ng, Ng);
for iy = 1:Ng
  for ix = 1:Ng
    fx = xs2(ix); fy = ys2(iy); fz = 0.0;
    bz = 0.0;
    for k = 1:N_seg
      Rxk = fx - rxs(k);
      Ryk = fy - rys(k);
      Rzk = fz - rzs(k);
      r2 = Rxk*Rxk + Ryk*Ryk + Rzk*Rzk;
      if r2 < 1e-10; r2 = 1e-10; end
      inv_r3 = 1.0 / (r2 ^ 1.5);
      bz = bz + (dlx(k)*Ryk - dly(k)*Rxk) * inv_r3;
    end
    Bz_grid(iy, ix) = bz * mu0 * I1 / (4 * pi);
  end
end

figure();
imagesc(real(Bz_grid), "viridis");
title("Bz from outer loop, sampled on the inner disk's plane");
savefig("mutual_Bz.svg");

# Integrate Bz over the inner-disk area to get Φ.
Phi_inner = 0.0;
for iy = 1:Ng
  for ix = 1:Ng
    if Xg(iy, ix)^2 + Yg(iy, ix)^2 <= a_i^2
      Phi_inner = Phi_inner + Bz_grid(iy, ix) * dxg * dyg;
    end
  end
end
M_num = real(Phi_inner / I1);
M_an  = mu0 * pi * a_i^2 / (2 * b_o);

print(M_num)            # ≈ 7.94e-9 H
print(M_an)             # ≈ 7.90e-9 H — small-a/b analytic
