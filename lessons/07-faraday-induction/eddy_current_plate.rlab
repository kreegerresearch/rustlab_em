# eddy_current_plate.rlab — Eddy currents in a thin conducting disk.
#
# Geometry:   copper disk of radius R = 6 cm centred in a 0.20 × 0.20 m
#             domain, σ = 5.8e7 S/m, axial Ḃz = 1 T/s applied uniformly.
# Method:     stream function ψ with J = ẑ × ∇ψ. Charge conservation is
#             automatic; Faraday's law gives ∇²ψ = -σ Ḃz (constant source
#             inside the plate). Pinning ψ = 0 outside the disk enforces
#             the insulated edge J·n̂ = 0 — a stream-function condition,
#             not a conductor.
# Verifies:   |J|(r) = σ Ḃz r / 2 inside the disk, circulating in the
#             sense that opposes Ḃz (Lenz's law).
#
# Reference: ../../notebooks/07-faraday-induction.md.

sigma_cu = 5.8e7;
Bdot     = 1.0;

set_default_axis("xy");        # physics y-axis for every imagesc panel below

nx3 = 100; ny3 = 100;
Lx3 = 0.20; Ly3 = 0.20;
dx3 = Lx3 / (nx3 + 1);
dy3 = Ly3 / (ny3 + 1);
xs3 = dx3 * (1:nx3) - Lx3/2;
ys3 = dy3 * (1:ny3) - Ly3/2;
[Xp, Yp] = meshgrid(xs3, ys3);

R_plate    = 0.06;
plate_mask = disk_mask(Xp, Yp, 0.0, 0.0, R_plate);

figure();
imagesc(plate_mask, "viridis");
title("Conducting plate mask (1 inside the disk, 0 outside)");
savefig("plate_mask.svg");

# === Stream-function Poisson, ψ = 0 outside the plate ===
L_p = laplacian_2d(nx3, ny3, dx3, dy3);
A_p = -1 * L_p;
n_p = nx3 * ny3;
src = sigma_cu * Bdot;

# Source σḂ (A/m³) in the plate cells; the column-major flatten of the
# mask matches the ij2k node ordering of laplacian_2d.
b_p = src * reshape(plate_mask, 1, n_p);

# Pin ψ = 0 on every cell outside the plate in one call.
[A_p, b_p] = pin_dirichlet(A_p, b_p, 1 - plate_mask, 0.0);

psi = real(reshape(spsolve(A_p, b_p), ny3, nx3));

figure();
hold on;
imagesc(psi, "viridis");
contour(Xp, Yp, psi, 14, "k");
title("Stream function psi(x, y) for the eddy-current pattern");
hold off;
savefig("eddy_psi.svg");

# === Recover J = ẑ × ∇ψ:  Jx = -∂ψ/∂y,  Jy = ∂ψ/∂x ===
[psi_x, psi_y] = gradient(psi, dx3, dy3);
Jx = -psi_y;
Jy = psi_x;
Jmag = sqrt(Jx .^ 2 + Jy .^ 2);

figure();
quiver(Xp, Yp, Jx, Jy, "Eddy-current density J = z-hat x grad(psi)");
xlabel("x (m)");
ylabel("y (m)");
savefig("eddy_J.svg");

figure();
imagesc(real(Jmag), "viridis");
title("|J|(x, y): linear ramp inside the disk, zero outside");
savefig("eddy_Jmag.svg");

# === Numerical vs analytic at the sampled radius nearest 0.7 R ===
i_c = round(ny3 / 2);
j_s = round(0.7 * R_plate / dx3) + nx3 / 2;   # column nearest r = 0.7R
r_s = sqrt(xs3(j_s)^2 + ys3(i_c)^2);          # actual sampled radius
print(r_s)                                    # ≈ 0.0406 m (vs 0.7R = 0.042 m)
print(real(Jmag(i_c, j_s)))                   # near-edge sample
print(sigma_cu * Bdot * r_s / 2.0)            # analytic at the sampled radius
print(real(Jmag(i_c, nx3 / 2 + 1)))           # near r = 0
