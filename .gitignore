# Per-lesson .r script artefacts. Scripts write plots alongside
# themselves; the canonical rendered output lives under book/, so
# nothing under lessons/ besides the source files needs to be tracked.
lessons/*/*.svg
lessons/*/*.html
lessons/*/*.png
lessons/*/*.gif

# Interactive HTML notebook build — auto-generated `make html` output
# living alongside the committed *.md (large Plotly bundles, regenerable).
book/*.html

# Un-hashed plot artefacts referenced only by the gitignored *.html
# build (`make html`). The committed *.md uses content-hashed filenames
# (plot-N-<hash>.svg, anim-N-<hash>.gif). Regenerated on every render.
book/plots/*/anim-[0-9]*.gif
!book/plots/*/anim-[0-9]*-[0-9a-f]*.gif
book/plots/*/plot-[0-9]*.svg
!book/plots/*/plot-[0-9]*-[0-9a-f]*.svg

# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp
